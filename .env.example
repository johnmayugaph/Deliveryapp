# PostgreSQL connection string. Prisma is the single source of truth for the schema.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliveryapp?schema=public"

# Direct (non-pooled) connection, used by `prisma migrate` when DATABASE_URL points
# at a connection pooler such as PgBouncer or Supabase's pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/deliveryapp?schema=public"

# Default city used for the home screen when a visitor has no saved address yet.
NEXT_PUBLIC_DEFAULT_CITY_ID="city_manila"

# --- Authentication -----------------------------------------------------------
# Keys the HMAC over login codes and the hash of client-address fingerprints.
# Generate with: openssl rand -hex 32
# Rotating it invalidates every outstanding login code (sessions survive, since
# those are hashed with plain SHA-256 of a random token).
AUTH_SECRET="replace-me-with-openssl-rand-hex-32-at-least-32-chars"

# SMS delivery. With no provider configured, development prints codes to the
# server console; production refuses to start a login rather than pretend to
# send. Semaphore (semaphore.co) is the seeded adapter — see
# src/lib/auth/sms/ to add another.
# SEMAPHORE_API_KEY=""
# SEMAPHORE_SENDER_NAME=""
