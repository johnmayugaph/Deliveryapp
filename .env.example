# PostgreSQL connection string. Prisma is the single source of truth for the schema.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tara?schema=public"

# Direct (non-pooled) connection, used by `prisma migrate` when DATABASE_URL points
# at a connection pooler such as PgBouncer or Supabase's pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tara?schema=public"

# Default city used for the home screen when a visitor has no saved address yet.
NEXT_PUBLIC_DEFAULT_CITY_ID="city_manila"

# --- Authentication -----------------------------------------------------------
# Keys the HMAC over login codes and the hash of client-address fingerprints.
# Generate with: openssl rand -hex 32
# Rotating it invalidates every outstanding login code (sessions survive, since
# those are hashed with plain SHA-256 of a random token).
AUTH_SECRET="replace-me-with-openssl-rand-hex-32-at-least-32-chars"

# SMS delivery. With no provider configured, development prints codes to the
# server console; production refuses to start a login rather than pretend to
# send. Semaphore (semaphore.co) is the seeded adapter — see
# src/lib/auth/sms/ to add another.
# SEMAPHORE_API_KEY=""
# SEMAPHORE_SENDER_NAME=""
#
# Send one real message to confirm the account works, before trusting it:
#   npm run sms:send-one -- 09171234567
#
# Redirects sends to another host. For pointing at a local stub in
# development; IGNORED when NODE_ENV=production, because a variable that
# can redirect message delivery is a way to capture login codes.
# SEMAPHORE_ENDPOINT=""

# --- Web push -----------------------------------------------------------------
# Generate ONCE with `npm run push:keys` and keep the pair. Rotating it does not
# rotate a credential — it invalidates every existing push subscription, because
# each browser bound its subscription to the public key it was handed, and there
# is no migration path. Back the private key up somewhere that is not a laptop.
#
# With no keys set, push is simply absent: the switch does not appear, and any
# queued push deliveries stay PENDING until keys exist rather than being thrown
# away.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# A mailto: address or https: URL a push service operator can use to reach you
# about your traffic. The only contact path when Google or Mozilla decides your
# sending pattern looks like abuse, so make it one somebody reads.
# VAPID_SUBJECT="mailto:ops@your-domain.ph"
