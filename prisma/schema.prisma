// =============================================================================
// TARA — unified multi-service schema
// =============================================================================
// Design rules this schema exists to enforce:
//
//  1. A vertical is DATA (a `Service` row), never a code branch. Anything that
//     differs between verticals is either a column on `Service` or an entry in
//     a per-service config map in `src/lib`. There is no hardcoded list of
//     services anywhere outside `prisma/seed.ts`.
//  2. There is ONE `Order` table for every vertical. Shared fields are real
//     columns; vertical-specific fields live in the `details` JSON container
//     whose shape is validated per service key in `src/lib/orders/details.ts`.
//  3. ONE `User` per person, with a `roles` ARRAY — the same person can be a
//     customer and a fleet partner at once. ONE address book, shared across
//     every vertical.
//  4. The fleet is service-neutral (`FleetPartner`), with per-service approval.
//  5. Credits are a ledger. `Wallet.balanceCentavos` is a derived cache of
//     `sum(WalletTransaction.amountCentavos)`; the ledger is the truth. There
//     is no top-up, transfer, or cash-out path anywhere in this schema.
//
// See docs/architecture.md for the reasoning behind each of these.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// The five verticals. Adding a member here is the ONLY code change a new
/// vertical requires at the schema level; everything else is a `Service` row
/// plus an entry in the order-details and lifecycle config maps.
enum ServiceKey {
  FOOD
  MART
  PARCEL
  PABILI
  RIDE
}

/// How a service is presented on the home screen. Group membership is a
/// property of the `Service` row, so regrouping the home screen is a data edit.
/// Human-readable group labels live in `src/lib/services/intent-groups.ts`.
enum IntentGroup {
  GO
  EAT
  GET
  PAY
}

/// The physical shape of the job. Dispatch and tracking read this instead of
/// asking "is this a food order?".
enum FulfilmentType {
  MERCHANT_TO_DOOR // a merchant prepares, a partner carries it to the door
  SHOPPER_TO_DOOR // a partner buys the goods, then carries them to the door
  POINT_TO_POINT // a partner moves a thing from A to B
  PASSENGER // a partner moves a person from A to B
}

/// Roles are held as an array on `User`. One person may hold several at once.
enum UserRole {
  CUSTOMER
  FLEET_PARTNER
  MERCHANT_OWNER
  SUPPORT_AGENT
  ADMIN
}

/// A SUPERSET of every state any vertical can be in. Which of these a given
/// service may actually enter, and in what order, is defined per service in
/// `src/lib/orders/transitions.ts` — not by the ordering of this enum.
enum OrderStatus {
  // --- pre-dispatch (all services) ---
  DRAFT
  PENDING_PAYMENT

  // --- merchant leg (services whose lifecycle includes acceptance) ---
  PENDING_MERCHANT_ACCEPTANCE
  MERCHANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP

  // --- dispatch leg (all services that require a fleet partner) ---
  AWAITING_RIDER_ASSIGNMENT
  RIDER_ASSIGNED
  RIDER_AT_PICKUP

  // --- shopper leg (SHOPPER_TO_DOOR fulfilment) ---
  SHOPPING_IN_PROGRESS
  AWAITING_BUDGET_APPROVAL

  // --- passenger leg (PASSENGER fulfilment) ---
  PASSENGER_ONBOARD

  // --- transit leg ---
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DROPOFF

  // --- terminal ---
  DELIVERED
  DROPPED_OFF
  COMPLETED
  FAILED_DELIVERY
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_MERCHANT
  CANCELLED_BY_RIDER
  CANCELLED_BY_SYSTEM
}

/// Who moved the order into a state. Recorded on every status event so support
/// can reconstruct a timeline without guessing.
enum OrderActor {
  CUSTOMER
  MERCHANT
  FLEET_PARTNER
  SUPPORT_AGENT
  SYSTEM
}

/// Deliberately short. `WALLET_CREDIT` spends the credits ledger; there is no
/// stored-value instrument here and no card-on-file rail yet.
enum PaymentMethod {
  CASH_ON_DELIVERY
  WALLET_CREDIT
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

/// The only five ways a credits balance can move. Note what is absent: there is
/// no TOP_UP, no TRANSFER_IN, no TRANSFER_OUT, and no WITHDRAWAL. That absence
/// is the product constraint, expressed in the type system.
enum WalletTransactionType {
  PROMO_CREDIT // granted by us (campaign, goodwill, credit-back benefit)
  REFUND // returned to the customer for a failed or cancelled order
  REFERRAL_BONUS // granted by us for a successful referral
  ORDER_PAYMENT // spent on an order inside the app — the only debit customers cause
  ADJUSTMENT // signed correction, requires an admin actor and a reason
}

/// What someone may do in a store's back office.
enum StoreRole {
  /// Everything, including menu, prices and settings.
  OWNER
  /// Everything except removing other members.
  MANAGER
  /// Works the order queue. Cannot change prices or settings.
  STAFF
}

enum VehicleType {
  ON_FOOT
  BICYCLE
  MOTORCYCLE
  TRICYCLE
  CAR
  MPV
  VAN
}

/// Verification is tracked PER SERVICE. Approved to carry food is not approved
/// to carry a passenger.
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The life of a dispatch offer.
enum DispatchOfferStatus {
  /// Sent, still within its window.
  PENDING
  ACCEPTED
  DECLINED
  /// The window closed with no answer. Counts against acceptance rate.
  EXPIRED
  /// Somebody else took the order first. Does NOT count against anyone.
  SUPERSEDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// How a subscription came to exist.
///
/// This is not decoration. A PAID subscription requires money to have changed
/// hands, and the app has no rail for that: `Order` payments are cash-on-delivery
/// or credits, and credits are spendable on orders only — by design, so they
/// cannot be turned into a subscription charge. Until a gateway exists, PAID
/// enrollment is refused at the door and the two grant origins are the only way
/// a subscription is created.
enum SubscriptionOrigin {
  /// Charged to a payment method. Needs a gateway; refused without one.
  PAID
  /// Given by us, deliberately, to a named person. Support goodwill, staff, a pilot.
  COMPED
  /// Given by a campaign — a launch cohort, a referral reward.
  PROMOTIONAL
}

/// Benefits are structured records the pricing engine reads, not marketing
/// copy. Each type uses a documented subset of the columns on
/// `SubscriptionBenefit`.
enum BenefitType {
  FREE_DELIVERY // uses minimumOrderCentavos + monthlyUsageCap
  DISCOUNT_PERCENT // uses percentBasisPoints + serviceKeys (+ optional cap)
  CREDIT_BACK_PERCENT // uses percentBasisPoints + monthlyCeilingCentavos
}

enum SupportTicketStatus {
  OPEN
  AWAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Where a snapshotted address sits in the job. Every order has exactly one of
/// each, whatever the vertical: food picks up at a store, a parcel picks up at
/// the sender, a ride picks up a passenger.
enum FulfilmentAddressRole {
  PICKUP
  DROPOFF
}

// -----------------------------------------------------------------------------
// 1. Service registry — each vertical defined as data
// -----------------------------------------------------------------------------

/// The registry. Every part of the product that needs to know something about a
/// vertical reads it from here. Seeded with all five services; only FOOD is
/// active. The other four exist as `isComingSoon` records so the home screen
/// can render them greyed with a "Coming soon" label — which doubles as demand
/// measurement before we build anything.
model Service {
  key         ServiceKey @id
  displayName String
  /// Short subtitle under the tile label, e.g. "Food delivery".
  tagline     String
  /// Icon identifier resolved by the client's icon map, not a file path, so the
  /// same row works for web and a future native client.
  icon        String
  description String

  intentGroup IntentGroup

  /// Tappable and orderable right now.
  isActive     Boolean @default(false)
  /// Rendered dimmed with a "Coming soon" label and NOT tappable.
  isComingSoon Boolean @default(true)
  sortOrder    Int

  fulfilmentType   FulfilmentType
  /// Whether an order in this vertical must reference a `Store`. Distinct from
  /// whether its lifecycle contains a merchant-acceptance step — that is a
  /// lifecycle question answered by `src/lib/orders/transitions.ts`.
  requiresMerchant Boolean
  /// Whether an order in this vertical must be assigned a `FleetPartner`.
  requiresRider    Boolean

  /// Cities where this service is orderable. Empty means "nowhere yet", which
  /// is the correct state for a coming-soon service.
  availableCityIds String[] @default([])

  /// Tailwind-ish colour token resolved by the client. Keeps per-service
  /// styling out of the components.
  accentToken String @default("brand")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  supportTickets   SupportTicket[]
  faqCategories    FaqCategory[]
  fleetApprovals   FleetPartnerServiceVerification[]
  deliveryFeeRules DeliveryFeeRule[]

  @@index([isActive, sortOrder])
  @@index([intentGroup, sortOrder])
}

/// Cities exist so `Service.availableCityIds` and address snapshots mean
/// something. Kept deliberately thin.
model City {
  id       String  @id
  name     String
  province String
  region   String
  isActive Boolean @default(true)

  centroidLat Float?
  centroidLng Float?

  addresses        Address[]
  stores           Store[]
  deliveryFeeRules DeliveryFeeRule[]

  @@index([isActive, name])
}

// -----------------------------------------------------------------------------
// 3. Unified identity and address book
// -----------------------------------------------------------------------------

/// ONE record per person, regardless of how many services they use or how many
/// roles they hold. A rider who orders lunch is this row twice over, not two
/// rows.
model User {
  id String @id @default(cuid())

  /// Philippine mobile number in E.164, e.g. +639171234567. The login identity.
  phone           String    @unique
  email           String?   @unique
  /// Set only when a code sent TO that address has been verified. An
  /// unverified email is worthless for recovery — anybody can type an address
  /// they do not control — so every recovery path checks this column, never
  /// `email` alone.
  emailVerifiedAt DateTime?
  /// NULL until the person tells us their name. A phone-first signup creates the
  /// record at the moment a code is verified, which is before they have typed
  /// anything else — pretending otherwise would put placeholder junk in the
  /// column and make every reader guess whether it is real.
  fullName        String?
  displayName     String?
  avatarUrl       String?
  /// Set the first time an OTP for this number is verified.
  phoneVerifiedAt DateTime?
  /// Set once the account has a name. Until then the app routes to /welcome.
  onboardedAt     DateTime?

  /// ROLES ARE AN ARRAY, not a single field. Someone can be a customer and a
  /// fleet partner simultaneously; the fleet works across every vertical it is
  /// approved for.
  roles UserRole[] @default([CUSTOMER])

  preferredCityId String?
  locale          String  @default("fil-PH")
  isBlocked       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses               Address[]
  orders                  Order[]
  wallet                  Wallet?
  fleetPartner            FleetPartner?
  subscriptions           UserSubscription[]
  supportTickets          SupportTicket[]
  supportMessages         SupportTicketMessage[]
  assignedTickets         SupportTicket[]                   @relation("SupportAgentTickets")
  statusEvents            OrderStatusEvent[]
  recordedAdjustments     WalletTransaction[]               @relation("WalletAdjustmentActor")
  sessions                Session[]
  storeMemberships        StoreMember[]
  fleetDecisions          FleetPartnerServiceVerification[] @relation("FleetVerificationDecider")
  grantedSubscriptions    UserSubscription[]                @relation("SubscriptionGrants")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       WebPushSubscription[]
  adminActions            AdminAuditEvent[]                 @relation("AdminAuditActor")
  recoveries              AccountRecovery[]
  assistedRecoveries      AccountRecovery[]                 @relation("RecoveryAssistedBy")

  @@index([roles], type: Gin)
  @@index([preferredCityId])
}

/// ONE address book per person, shared across every vertical. An address saved
/// while ordering food is immediately available as a parcel pickup.
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// User-chosen name: "Home", "Lola's house", "Office".
  label String

  line1         String
  line2         String?
  barangay      String?
  cityId        String
  city          City    @relation(fields: [cityId], references: [id])
  province      String
  postalCode    String?
  landmark      String?
  /// Free-text rider instructions: "green gate, ring twice".
  deliveryNotes String?

  latitude  Float
  longitude Float

  /// Contact at the address — not necessarily the account holder.
  contactName  String?
  contactPhone String?

  /// Some saved places make sense as origins, not just destinations. A parcel
  /// pickup or a ride start reads this.
  isPickupCapable Boolean @default(false)
  isDefault       Boolean @default(false)

  /// Maintained by `bumpAddressUsage()` in src/lib/addresses/usage.ts so the
  /// address picker can order by real behaviour rather than creation date.
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt, usageCount(sort: Desc)])
  @@index([userId, isPickupCapable])
  @@index([userId, lastUsedAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Authentication — one-time codes over SMS, opaque server-side sessions
// -----------------------------------------------------------------------------

/// A login session.
///
/// The cookie carries an opaque random token; this table stores only its SHA-256
/// hash, so a database dump does not hand over live sessions. Server-side rows
/// rather than a self-contained JWT because a session must be REVOCABLE — a
/// signed token that says "valid for 30 days" cannot be taken back.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie token, hex. Never the token itself.
  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  /// Bumped on use, so a stale session can be spotted and a sliding window
  /// extended without issuing a new token.
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  /// Coarse provenance for the "signed in on" list, and for spotting a session
  /// that suddenly moves. Truncated user agent and a HASHED ip — we do not need
  /// to keep the address itself to notice that it changed.
  userAgent String?
  ipHash    String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// A one-time code sent to a phone number.
///
/// Stores an HMAC of the code, not the code. A six-digit code has only a
/// million possibilities, so the HMAC is keyed with `AUTH_SECRET`: without the
/// secret a stolen database cannot be brute-forced back to live codes, and with
/// a five-minute expiry there is nothing much left to steal anyway.
model PhoneVerification {
  id    String @id @default(cuid())
  /// E.164, normalised before it ever reaches this table.
  phone String

  /// HMAC-SHA256(code, AUTH_SECRET), hex.
  codeHash String

  expiresAt  DateTime
  /// Failed verifications. The code dies at `MAX_VERIFY_ATTEMPTS`, so an online
  /// guess gets a handful of tries rather than a million.
  attempts   Int       @default(0)
  /// Single use: set the moment a code succeeds.
  consumedAt DateTime?

  /// Hashed requester address, for throttling bulk requests from one source
  /// without keeping a log of who asked.
  requestIpHash String?

  createdAt DateTime @default(now())

  /// Powers the per-phone throttle and "most recent code wins".
  @@index([phone, createdAt(sort: Desc)])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

/// A code sent to an email address.
///
/// Deliberately a separate table from `PhoneVerification` rather than one
/// table with a nullable phone and a nullable email. The two are different
/// enough in what they are for — one proves you hold the login identity, the
/// other proves you hold a recovery channel — that a shared table would need a
/// discriminator column and a CHECK constraint to stop rows meaning nothing.
/// The policy module is shared instead, which is where the logic actually is.
model EmailVerification {
  id String @id @default(cuid())

  /// Lower-cased and trimmed before it ever reaches this table.
  email String

  /// What the code is for. A code minted to confirm an address must not be
  /// usable to recover an account, and the other way round.
  purpose EmailCodePurpose

  /// HMAC-SHA256(code, AUTH_SECRET), hex. The plaintext is never stored.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  requestIpHash String?

  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt(sort: Desc)])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

enum EmailCodePurpose {
  /// Confirming an address the person typed while signed in.
  VERIFY_ADDRESS
  /// Proving control of a previously verified address, to move the phone.
  ACCOUNT_RECOVERY
}

// -----------------------------------------------------------------------------
// Merchants and catalogue (supporting cast for FOOD, reused later by MART)
// -----------------------------------------------------------------------------

model Store {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// A store can be orderable in more than one vertical — the same sari-sari
  /// store may serve MART now and FOOD later. Read this, do not assume FOOD.
  serviceKeys ServiceKey[] @default([])

  description String?
  logoUrl     String?
  coverUrl    String?

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  addressLine  String
  latitude     Float
  longitude    Float
  contactPhone String?

  isOpen    Boolean @default(true)
  isVisible Boolean @default(true)

  /// Merchant's own quoted prep time, snapshotted into FOOD order details at
  /// checkout so a later menu edit cannot rewrite history.
  preparationMinutes Int @default(20)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]
  members   StoreMember[]

  @@index([cityId, isVisible, isOpen])
  @@index([serviceKeys], type: Gin)
}

model MenuItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  category      String  @default("Main")
  priceCentavos Int
  imageUrl      String?
  isAvailable   Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isAvailable, sortOrder])
}

// -----------------------------------------------------------------------------
// Delivery pricing — rates as data
// -----------------------------------------------------------------------------

/// Distance-based delivery pricing, per service and per city.
///
/// These are rates ops will want to tune weekly. Putting them in code would
/// mean a deploy to change a fee, so they live here: `quoteDeliveryFee()` reads
/// this table and contains no numbers of its own. A city with no rule for a
/// service simply cannot be quoted, which is the correct failure — better than
/// silently applying a Manila rate in Cebu.
model DeliveryFeeRule {
  id String @id @default(cuid())

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  /// Null means "every city where the service is live" — a fallback rule.
  /// A city-specific rule always wins over the fallback.
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  /// Charged before any distance.
  baseFeeCentavos      Int
  /// Distance included in the base fee, metres.
  includedMeters       Int  @default(0)
  /// Per kilometre beyond `includedMeters`, charged pro rata.
  perKilometreCentavos Int
  /// Floor and ceiling on the computed fee.
  minimumFeeCentavos   Int  @default(0)
  maximumFeeCentavos   Int?

  /// Subtotal at or above which delivery is free regardless of distance. Null
  /// disables the threshold. Distinct from the subscription FREE_DELIVERY
  /// benefit: this one applies to everybody.
  freeAboveSubtotalCentavos Int?

  /// Charged when the subtotal is below `smallOrderThresholdCentavos`.
  smallOrderThresholdCentavos Int?
  smallOrderFeeCentavos       Int  @default(0)

  /// Flat platform fee for this service/city.
  serviceFeeCentavos Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One rule per service per city, plus one fallback per service.
  @@unique([serviceType, cityId])
  @@index([serviceType, isActive])
}

/// Who may work a store's back office.
///
/// A join table rather than an owner column on `Store`, because the real shape
/// is many-to-many in both directions: a karinderya owner works the queue
/// alongside two staff, and a small chain owner holds several stores. An owner
/// column would force a second source of truth the first time either happened.
///
/// Store access is granted HERE and nowhere else. `User.roles` carrying
/// MERCHANT_OWNER says what kind of person someone is; this table says which
/// stores they may actually touch, which is the question every merchant action
/// has to answer.
model StoreMember {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role StoreRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 2. Unified order model — one table for every vertical
// -----------------------------------------------------------------------------

/// The base record for EVERY vertical. Shared concerns are columns here;
/// vertical-specific concerns live in `details`.
model Order {
  id          String @id @default(cuid())
  /// Human-facing reference, shown in support and receipts.
  orderNumber String @unique

  /// References `Service.key`. The FK is what makes "unknown vertical"
  /// unrepresentable.
  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  status OrderStatus @default(DRAFT)

  /// Exactly two rows per order: one PICKUP, one DROPOFF. Each is a full
  /// snapshot taken at placement — editing the address book never rewrites a
  /// past order.
  addresses OrderAddress[]

  // --- fee breakdown, all in CENTAVOS (integer). Never store money as float.
  subtotalCentavos             Int    @default(0)
  deliveryFeeCentavos          Int    @default(0)
  serviceFeeCentavos           Int    @default(0)
  smallOrderFeeCentavos        Int    @default(0)
  surgeCentavos                Int    @default(0)
  tipCentavos                  Int    @default(0)
  /// Promo/voucher discount, stored positive and subtracted.
  promoDiscountCentavos        Int    @default(0)
  /// Discount attributable to an active subscription benefit, kept separate so
  /// we can measure what the tier actually costs us.
  subscriptionDiscountCentavos Int    @default(0)
  /// Credits spent on this order. Mirrors the ORDER_PAYMENT ledger entry.
  walletCreditAppliedCentavos  Int    @default(0)
  /// What the customer owes after everything above.
  totalCentavos                Int    @default(0)
  currency                     String @default("PHP")

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  /// Field name kept as `assignedRiderId` per the shared-field contract even
  /// though the fleet model is service-neutral.
  assignedRiderId String?
  assignedRider   FleetPartner? @relation(fields: [assignedRiderId], references: [id])

  /// Vertical-specific payload. Shape is validated per service key by
  /// `parseOrderDetails()` in src/lib/orders/details.ts. Only the FOOD shape is
  /// implemented; the other four are documented placeholders.
  details Json @default("{}")

  // --- timestamps ---
  placedAt    DateTime?
  acceptedAt  DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  /// Best current estimate shown on the tracking screen.
  etaAt       DateTime?

  cancellationReason String?
  cancelledBy        OrderActor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents       OrderStatusEvent[]
  dispatchOffers     DispatchOffer[]
  walletTransactions WalletTransaction[]
  supportTickets     SupportTicket[]
  appliedBenefits    OrderAppliedBenefit[]
  notifications      Notification[]

  /// Powers the unified cross-service order history: one chronological list,
  /// every vertical, no per-service queries.
  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerId, status])
  @@index([serviceType, status])
  @@index([assignedRiderId, status])
  @@index([status, createdAt])
}

/// A full address snapshot bound to an order. Denormalised on purpose: an order
/// must remain readable years later even if the source `Address` row is edited
/// or deleted.
model OrderAddress {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  role FulfilmentAddressRole

  /// Where this snapshot came from, when it came from the address book at all.
  /// Nullable because a store pickup or a map-pin dropoff has no book entry.
  sourceAddressId String?

  label         String?
  line1         String
  line2         String?
  barangay      String?
  cityId        String
  cityName      String
  province      String
  postalCode    String?
  landmark      String?
  deliveryNotes String?

  latitude  Float
  longitude Float

  contactName  String?
  contactPhone String?

  createdAt DateTime @default(now())

  @@unique([orderId, role])
  @@index([cityId])
}

/// Append-only audit of every status change, written by the state machine. Also
/// what the tracking screen renders as a timeline.
model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actor       OrderActor
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id])
  reason      String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// -----------------------------------------------------------------------------
// 4. Unified fleet — service-neutral, per-service approval
// -----------------------------------------------------------------------------

/// Formerly `RiderProfile`. Renamed because the same person will eventually
/// deliver food, carry parcels, and possibly drive passengers, and a name that
/// says "rider" invites food-shaped assumptions.
model FleetPartner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which services this partner is APPROVED to work. Dispatch builds its
  /// candidate list from this array; everything else about ranking is unchanged.
  /// Derived from `serviceVerifications` — kept denormalised because dispatch
  /// reads it on every candidate query.
  enabledServices ServiceKey[] @default([])

  vehicleType  VehicleType
  vehiclePlate String?
  vehicleModel String?
  /// Insulated bag, top box, child seat, etc. Some services will require some
  /// of these; that requirement belongs in config, not here.
  equipment    String[]    @default([])

  homeCityId String?

  isOnline    Boolean @default(false)
  isSuspended Boolean @default(false)

  currentLatitude   Float?
  currentLongitude  Float?
  locationUpdatedAt DateTime?

  ratingAvg           Float @default(0)
  ratingCount         Int   @default(0)
  completedOrderCount Int   @default(0)
  acceptanceRate      Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceVerifications FleetPartnerServiceVerification[]
  orders               Order[]
  dispatchOffers       DispatchOffer[]

  @@index([isOnline, isSuspended, homeCityId])
  @@index([enabledServices], type: Gin)
}

/// Verification status held PER SERVICE. A partner approved for food delivery
/// is not automatically approved to carry passengers, and this table is where
/// the model says so out loud.
model FleetPartnerServiceVerification {
  id             String       @id @default(cuid())
  fleetPartnerId String
  fleetPartner   FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  status VerificationStatus @default(NOT_SUBMITTED)

  /// Document identifiers required for THIS service (e.g. a professional
  /// driver's licence for RIDE, a food-handler card for FOOD).
  submittedDocuments String[] @default([])

  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("FleetVerificationDecider", fields: [decidedByUserId], references: [id])
  rejectionReason String?
  expiresAt       DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fleetPartnerId, serviceType])
  @@index([serviceType, status])
}

/// An order offered to one fleet partner.
///
/// Offers are records rather than a transient push, for two reasons. It makes
/// `FleetPartner.acceptanceRate` mean something — without a row saying "this
/// was offered and went unanswered" that column is decorative. And it makes
/// the race safe: several partners can hold a PENDING offer for the same order,
/// and the first to accept wins on the state machine's optimistic guard while
/// the rest are SUPERSEDED rather than penalised.
model DispatchOffer {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fleetPartnerId String
  fleetPartner   FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)

  status DispatchOfferStatus @default(PENDING)

  /// Position in the ranked candidate list when the offer was made, and the
  /// distance it was ranked on. Kept so a dispatch decision can be reviewed
  /// after the partners have moved.
  rank           Int
  distanceMeters Int

  offeredAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())

  /// One offer per partner per order: re-offering the same job to the same
  /// person is how an acceptance rate gets quietly destroyed.
  @@unique([orderId, fleetPartnerId])
  @@index([fleetPartnerId, status, expiresAt])
  @@index([orderId, status])
  @@index([status, expiresAt])
}

// -----------------------------------------------------------------------------
// 5. Credits — a ledger, and nothing else
// -----------------------------------------------------------------------------
// HARD CONSTRAINTS, enforced in src/lib/wallet/ledger.ts and by the SQL guard
// in prisma/sql/wallet_append_only.sql:
//   * No top-up. A customer cannot add their own cash to a balance.
//   * No transfers between users.
//   * No withdrawal or cash-out.
//   * Balance can only be spent on orders inside the app.
// Surfaced in the UI as "Credits" / "Rewards" — never "wallet" or "e-money".
// -----------------------------------------------------------------------------

/// One per user. `balanceCentavos` is a DERIVED CACHE of the ledger sum, written
/// only by `recordWalletTransaction()`. Never update it directly.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived: sum(transactions.amountCentavos). The ledger is the truth.
  balanceCentavos Int    @default(0)
  currency        String @default("PHP")

  /// Blocks spending without deleting history, e.g. during a fraud review or
  /// the cooling-off period after the account's phone number changed.
  isFrozen     Boolean   @default(false)
  frozenReason String?
  /// When the freeze lifts on its own. NULL means indefinite — a fraud review
  /// ends when somebody ends it. Set for the recovery cooling-off period,
  /// which is the whole reason recovery is not a way to steal a balance:
  /// taking over an account buys you credits you cannot spend for three days,
  /// by which time the alert has reached the real owner.
  frozenUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

/// APPEND-ONLY ledger. Every balance change is a row here, written by exactly
/// one backend function. There is no UPDATE or DELETE path in application code,
/// and the SQL guard rejects both at the database level.
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type WalletTransactionType

  /// SIGNED amount in centavos. Credits are positive, ORDER_PAYMENT is
  /// negative, ADJUSTMENT may be either. The sign is forced by `type` in
  /// `recordWalletTransaction()`, never supplied by a caller.
  amountCentavos Int

  /// The recomputed ledger sum immediately after this row. Lets us detect
  /// drift: a replay of the ledger must reproduce every value in this column.
  balanceAfterCentavos Int

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id])

  /// Customer-visible line in the credits history.
  description String

  /// Set for ADJUSTMENT rows: which admin made the correction.
  adminUserId String?
  adminUser   User?   @relation("WalletAdjustmentActor", fields: [adminUserId], references: [id])

  /// Makes granting idempotent — a retried promo campaign cannot double-credit.
  idempotencyKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  /// Note the absence of `updatedAt`. This table is not updated.
  @@index([walletId, createdAt(sort: Desc)])
  @@index([relatedOrderId])
  @@index([type, createdAt])
}

// -----------------------------------------------------------------------------
// 6. Subscription tier
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  tagline              String?
  monthlyPriceCentavos Int
  currency             String  @default("PHP")

  /// Seeded plan ships INACTIVE. Flip this when we decide to launch.
  isActive  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The benefits array. Structured records the pricing engine reads.
  benefits      SubscriptionBenefit[]
  subscriptions UserSubscription[]

  @@index([isActive, sortOrder])
}

/// One structured benefit. Which columns are meaningful depends on `type`:
///   FREE_DELIVERY       -> minimumOrderCentavos, monthlyUsageCap
///   DISCOUNT_PERCENT    -> percentBasisPoints, serviceKeys, maxDiscountCentavos
///   CREDIT_BACK_PERCENT -> percentBasisPoints, monthlyCeilingCentavos
/// `src/lib/pricing/checkout.ts` validates that pairing before applying it.
model SubscriptionBenefit {
  id     String           @id @default(cuid())
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type BenefitType

  /// Empty means "every active service". Otherwise the benefit applies only to
  /// these service keys — this is how a discount gets scoped without a branch.
  serviceKeys ServiceKey[] @default([])

  /// Basis points, so 1250 == 12.5%. Whole-percent columns force us to
  /// re-migrate the first time marketing wants 7.5%.
  percentBasisPoints Int?

  /// FREE_DELIVERY: the order subtotal the benefit needs to trigger.
  minimumOrderCentavos   Int?
  /// FREE_DELIVERY: how many times per calendar month it may be used.
  monthlyUsageCap        Int?
  /// DISCOUNT_PERCENT: per-order ceiling on the discount.
  maxDiscountCentavos    Int?
  /// CREDIT_BACK_PERCENT: how much credit-back this benefit may accrue per
  /// calendar month.
  monthlyCeilingCentavos Int?

  /// Shown on the plan card. Never read by the pricing engine.
  displayLabel String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages          SubscriptionBenefitUsage[]
  appliedToOrders OrderAppliedBenefit[]

  @@index([planId, type])
}

model UserSubscription {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  /// No default: how a subscription was obtained is never a guess.
  origin SubscriptionOrigin

  /// Who granted a COMPED or PROMOTIONAL subscription, and why. A grant with no
  /// grantor is how comps quietly become policy.
  grantedByUserId String?
  grantedBy       User?   @relation("SubscriptionGrants", fields: [grantedByUserId], references: [id])
  grantNote       String?

  startedAt   DateTime  @default(now())
  renewsAt    DateTime
  cancelledAt DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  benefitUsages SubscriptionBenefitUsage[]

  /// One live subscription per person, enforced by a partial unique index in
  /// `prisma/sql/subscriptions.sql` — Prisma cannot express one, and an index
  /// alone would not stop a double enrollment from a double-clicked button.
  /// History is preserved by `endedAt`.
  @@index([userId, status])
  @@index([status, renewsAt])
  @@index([grantedByUserId])
}

/// Tracks consumption of capped benefits within a calendar month, so
/// `monthlyUsageCap` and `monthlyCeilingCentavos` are enforceable rather than
/// aspirational.
model SubscriptionBenefitUsage {
  id                 String              @id @default(cuid())
  userSubscriptionId String
  userSubscription   UserSubscription    @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  benefitId          String
  benefit            SubscriptionBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  /// First instant of the calendar month this row accounts for, in UTC.
  periodStart DateTime

  usageCount         Int @default(0)
  creditedCentavos   Int @default(0)
  discountedCentavos Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userSubscriptionId, benefitId, periodStart])
  @@index([periodStart])
}

/// What a specific order actually received, so we can answer "why was this
/// cheaper?" without re-running the pricing engine against changed config.
model OrderAppliedBenefit {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  benefitId String?
  benefit   SubscriptionBenefit? @relation(fields: [benefitId], references: [id])

  type               BenefitType
  displayLabel       String
  /// Positive centavos taken off the total by this benefit.
  amountCentavos     Int
  /// For CREDIT_BACK_PERCENT: credits to grant on completion, not a discount.
  creditBackCentavos Int         @default(0)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([benefitId, createdAt])
}

// -----------------------------------------------------------------------------
// 8. Unified support
// -----------------------------------------------------------------------------

/// One ticket model covering all services.
model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The vertical the ticket is about. NULL means an account-level or general
  /// issue that belongs to no single service.
  serviceType ServiceKey?
  service     Service?    @relation(fields: [serviceType], references: [key])

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id])

  /// Slug of the `FaqCategory` the customer entered through, so we can see
  /// which help topics generate tickets.
  categorySlug String?

  subject String
  body    String

  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(NORMAL)

  assignedAgentId String?
  assignedAgent   User?   @relation("SupportAgentTickets", fields: [assignedAgentId], references: [id])

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, priority, createdAt])
  @@index([serviceType, status])
  @@index([relatedOrderId])
}

model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorUserId  String?
  author        User?   @relation(fields: [authorUserId], references: [id])
  isFromSupport Boolean @default(false)

  body        String
  attachments String[] @default([])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Help-section categories. Driven by the Service registry: a category with a
/// `serviceType` only appears once that service exists, and a NULL
/// `serviceType` is the general/account section.
model FaqCategory {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  serviceType ServiceKey?
  service     Service?    @relation(fields: [serviceType], references: [key])

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles FaqArticle[]

  @@index([serviceType, sortOrder])
  @@index([isActive, sortOrder])
}

model FaqArticle {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  question  String
  answer    String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

// -----------------------------------------------------------------------------
// 7. Home screen supporting data
// -----------------------------------------------------------------------------

/// Promotions rail on the home screen. Scoped to service keys so a food-only
/// promo does not advertise itself once MART launches.
model Promotion {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String?
  ctaHref  String?

  serviceKeys ServiceKey[] @default([])
  cityIds     String[]     @default([])

  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([serviceKeys], type: Gin)
}

// -----------------------------------------------------------------------------
// 9. Notifications — an outbox, not a fire-and-forget
// -----------------------------------------------------------------------------

/// What happened. One value per moment worth telling somebody about, NOT one
/// per order status: most statuses are internal, and the map in
/// `src/lib/notifications/order-events.ts` decides which of them earn a message.
enum NotificationKind {
  /// To the store: an order is waiting for a decision.
  ORDER_SUBMITTED
  /// To the customer: the store took it.
  ORDER_ACCEPTED
  /// To the customer: it is ready and looking for a rider.
  ORDER_READY
  /// To the customer: a partner is on it.
  ORDER_RIDER_ASSIGNED
  /// To the customer: collected from the store.
  ORDER_PICKED_UP
  /// To the customer: the rider is outside.
  ORDER_ARRIVED
  /// To the customer: delivered.
  ORDER_DELIVERED
  /// To the customer, and to the store when the store was not the one who did it.
  ORDER_CANCELLED
  /// To the store: nobody answered in time and the order was lost.
  ORDER_LOST_TO_TIMEOUT
  /// To a fleet partner: a job is on offer, and the clock is running.
  DISPATCH_OFFER
  /// To the customer: credits arrived — credit-back, a refund, a promo.
  CREDITS_GRANTED
  /// To the subscriber: the term ended.
  SUBSCRIPTION_ENDED
  /// To the account: something changed about who can get into it. The one kind
  /// that exists to be unwelcome — if the person did not do this, they need to
  /// know within seconds, not at their convenience.
  SECURITY_ALERT
}

/// How a message reaches someone.
///
/// IN_APP is the inbox and is always written — it is the record, and the only
/// channel that cannot fail for a reason outside our control.
///
/// PUSH reaches a closed tab and costs nothing per message, which is why it
/// carries every kind while SMS carries only the ones worth a peso. It needs a
/// browser that has granted permission and a live `WebPushSubscription`.
///
/// SMS reaches a phone with no app installed and no permission granted, which
/// is the one thing push cannot do. It is the expensive fallback, not the
/// default.
enum NotificationChannel {
  IN_APP
  PUSH
  SMS
}

/// Whether a message is worth interrupting someone for.
///
/// OPERATIONAL means somebody is waiting on an action: a store has an order to
/// accept, a partner has 60 seconds to answer. These ignore quiet hours.
/// INFORMATIONAL is news about something already in motion.
enum NotificationUrgency {
  OPERATIONAL
  INFORMATIONAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  /// Attempted and given up on, with the reason kept.
  FAILED
  /// Not attempted, on purpose: the recipient turned this channel off.
  SKIPPED
}

/// One thing that happened, addressed to one person.
///
/// A row per recipient rather than per event: "who has read this" is a property
/// of a person, and a shared row would need a join table to answer it.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    NotificationKind
  urgency NotificationUrgency

  /// Rendered at enqueue time, from the template map. Stored rather than
  /// re-rendered on read: what someone was told should not change because the
  /// copy was later edited, and the SMS body is already gone by then anyway.
  title String
  body  String

  /// The short form, for channels with no screen around them. Stored beside the
  /// long form because a text has to carry its own context — which order, which
  /// deadline — and because re-rendering at send time would let an edited
  /// template rewrite a message already queued.
  smsBody String

  /// Where tapping it goes — an in-app path, never an absolute URL.
  href String?

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  /// Makes enqueueing idempotent. A retried transition, a cron that runs twice,
  /// two tabs both advancing the same order — all collapse onto one row.
  dedupeKey String @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([relatedOrderId])
}

/// One attempt to put a notification through one channel.
///
/// Separate from `Notification` because delivery is per-channel and fails
/// per-channel: an SMS gateway timing out must not lose the inbox copy, and a
/// retry needs somewhere to count attempts.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  attempts          Int       @default(0)
  /// When the next attempt becomes due. Backoff writes this forward.
  nextAttemptAt     DateTime  @default(now())
  sentAt            DateTime?
  /// Kept on failure. A gateway's own words are usually the fastest diagnosis.
  lastError         String?
  /// Which sender handled it, and its reference, for support.
  provider          String?
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One delivery per channel per notification.
  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

/// A person's channel switches.
///
/// Absent means "the default for that channel", which lives in code — so a new
/// channel does not need a backfill to start behaving sensibly. IN_APP is not
/// representable here on purpose: the inbox is the record, and turning it off
/// would mean losing history rather than being left alone.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  enabled Boolean

  updatedAt DateTime @updatedAt

  @@unique([userId, channel])
}

/// A browser that has agreed to receive push, and the keys to encrypt for it.
///
/// One row per browser profile, not per person: somebody with a phone and a
/// laptop has two, and each has its own keys. The push service hands out the
/// endpoint; re-subscribing the same profile returns the same one, which is why
/// it is the natural unique key rather than a (user, device) pair we would have
/// to invent.
///
/// The two keys are the client's half of RFC 8291. They are not secrets we
/// chose and cannot be regenerated on our side — losing them means the
/// subscription is unusable and the browser has to subscribe again.
model WebPushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service's URL for this browser. Distinct per browser vendor:
  /// fcm.googleapis.com for Chrome, updates.push.services.mozilla.com for
  /// Firefox, web.push.apple.com for Safari.
  endpoint String @unique
  /// The browser's P-256 public key: 65 bytes uncompressed, base64url.
  p256dh   String
  /// The browser's 16-byte auth secret, base64url. Mixed into the key
  /// derivation so a push service that sees the ciphertext cannot read it.
  auth     String

  /// What the browser called itself when it subscribed, so somebody can
  /// recognise which device to remove from a list.
  userAgent String?

  createdAt  DateTime @default(now())
  /// Touched on every successful send. A stale value is how a dead device is
  /// spotted before the push service admits it.
  lastSeenAt DateTime @default(now())

  /// Set when the push service answers 404 or 410: the browser is gone for
  /// good. Kept rather than deleted, because "this person had push and lost
  /// it" is the answer to a support question that a missing row cannot give.
  expiredAt    DateTime?
  /// Consecutive soft failures — a 500 from the push service, a timeout.
  /// Reset on success. Not a reason to give up on its own.
  failureCount Int       @default(0)

  /// The delivery pass reads live subscriptions for one user, in this order.
  @@index([userId, expiredAt])
}

// -----------------------------------------------------------------------------
// 12. The admin console, and what it did
// -----------------------------------------------------------------------------

/// What an admin did. Named after the effect, not the screen it happened on.
///
/// Deliberately a closed set rather than a free-text action: a log you can
/// filter is a log somebody reads, and a new kind of privileged action should
/// be a decision, not a string somebody typed.
enum AdminAction {
  /// A vertical was switched on or off for everyone.
  SERVICE_AVAILABILITY_CHANGED
  /// A vertical was launched in, or withdrawn from, a city.
  SERVICE_CITY_CHANGED
  /// Somebody was blocked or unblocked.
  USER_BLOCK_CHANGED
  /// A signed correction to a credits balance, through the ledger.
  CREDITS_ADJUSTED
  /// A failed notification delivery was put back in the queue.
  DELIVERY_REQUEUED
  /// A complimentary subscription was granted or ended.
  SUBSCRIPTION_CHANGED
  /// An account's phone number was moved by support.
  ACCOUNT_RECOVERED
}

/// One privileged action, and why.
///
/// APPEND-ONLY, enforced by a trigger, for the same reason the credits ledger
/// is: an audit trail that can be edited answers no question worth asking. A
/// mistaken entry is corrected by a later entry.
///
/// `reason` is NOT NULL and non-trivial by CHECK constraint. An audit row
/// saying only that somebody's balance changed is a row nobody can act on —
/// support needs to know it was ticket #482, and the person deciding whether
/// this was legitimate needs it more.
model AdminAuditEvent {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id])

  action AdminAction

  /// The model that was touched, e.g. "User", "Service". A plain string rather
  /// than a relation because the subject can be any table, and a nullable
  /// foreign key per table would be a column per table.
  subjectType  String
  subjectId    String
  /// Something a person recognises without a lookup — a phone, a service key,
  /// an order number. Denormalised on purpose: the subject may later be
  /// renamed or deleted, and the log should still read.
  subjectLabel String

  reason String

  /// What changed, as before/after. Read-only, and never used for logic.
  detail Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([action, createdAt])
}

// -----------------------------------------------------------------------------
// 13. Account recovery
// -----------------------------------------------------------------------------

/// How somebody proved they should get the account back.
enum RecoveryMethod {
  /// Two channels: a code to an address verified BEFORE the phone was lost,
  /// then a code to the new number. Self-service, no human involved.
  VERIFIED_EMAIL
  /// An administrator moved the number, with a reason, through the console.
  /// For the people who never added an email — which will be most of them.
  SUPPORT_ASSISTED
}

/// One change of the login identity, and everything about it.
///
/// APPEND-ONLY, enforced by trigger, like the credits ledger and the admin
/// audit trail. This is the record of the single most dangerous operation in
/// the system: whoever holds an account's phone number holds its credits
/// balance, its order history and its saved addresses. A recovery that could
/// be edited afterwards would make the whole feature untrustworthy.
///
/// `previousPhone` is kept on purpose, and it is the ONLY place the old number
/// survives after the change — `User.phone` has moved on. It is what the
/// security alert is sent to, and what answers "was this me" months later.
model AccountRecovery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method RecoveryMethod

  /// The number the account had before. E.164.
  previousPhone String
  /// The number it has now. E.164.
  newPhone      String

  /// The address the code went to, for VERIFIED_EMAIL. NULL for a support
  /// recovery, where no email was involved.
  viaEmail String?

  /// Who did it, for SUPPORT_ASSISTED. NULL for self-service — the person
  /// themselves is `user`, and naming them twice would suggest otherwise.
  assistedByUserId String?
  assistedBy       User?   @relation("RecoveryAssistedBy", fields: [assistedByUserId], references: [id])
  /// Required for SUPPORT_ASSISTED by CHECK constraint. An identity moved
  /// without a written reason is indistinguishable from a takeover.
  reason           String?

  /// When the cooling-off freeze on the credits balance lifts.
  creditsFrozenUntil DateTime

  /// When the alert to `previousPhone` went out. NULL means it is still
  /// queued: the maintenance sweep sends it, because the recipient is a number
  /// this account no longer has and the outbox resolves recipients from the
  /// user row.
  alertSentAt DateTime?
  /// Kept if the alert could not be sent, so a failure is visible rather than
  /// looking like it was never attempted.
  alertError  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([previousPhone])
  /// The sweep's queue: recoveries whose alert has not gone out.
  @@index([alertSentAt, createdAt])
}
