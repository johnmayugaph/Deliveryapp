// =============================================================================
// TARA — unified multi-service schema
// =============================================================================
// Design rules this schema exists to enforce:
//
//  1. A vertical is DATA (a `Service` row), never a code branch. Anything that
//     differs between verticals is either a column on `Service` or an entry in
//     a per-service config map in `src/lib`. There is no hardcoded list of
//     services anywhere outside `prisma/seed.ts`.
//  2. There is ONE `Order` table for every vertical. Shared fields are real
//     columns; vertical-specific fields live in the `details` JSON container
//     whose shape is validated per service key in `src/lib/orders/details.ts`.
//  3. ONE `User` per person, with a `roles` ARRAY — the same person can be a
//     customer and a fleet partner at once. ONE address book, shared across
//     every vertical.
//  4. The fleet is service-neutral (`FleetPartner`), with per-service approval.
//  5. Credits are a ledger. `Wallet.balanceCentavos` is a derived cache of
//     `sum(WalletTransaction.amountCentavos)`; the ledger is the truth. There
//     is no top-up, transfer, or cash-out path anywhere in this schema.
//
// See docs/architecture.md for the reasoning behind each of these.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// The five verticals. Adding a member here is the ONLY code change a new
/// vertical requires at the schema level; everything else is a `Service` row
/// plus an entry in the order-details and lifecycle config maps.
enum ServiceKey {
  FOOD
  MART
  PARCEL
  PABILI
  RIDE
}

/// How a service is presented on the home screen. Group membership is a
/// property of the `Service` row, so regrouping the home screen is a data edit.
/// Human-readable group labels live in `src/lib/services/intent-groups.ts`.
enum IntentGroup {
  GO
  EAT
  GET
  PAY
}

/// The physical shape of the job. Dispatch and tracking read this instead of
/// asking "is this a food order?".
enum FulfilmentType {
  MERCHANT_TO_DOOR // a merchant prepares, a partner carries it to the door
  SHOPPER_TO_DOOR // a partner buys the goods, then carries them to the door
  POINT_TO_POINT // a partner moves a thing from A to B
  PASSENGER // a partner moves a person from A to B
}

/// Roles are held as an array on `User`. One person may hold several at once.
enum UserRole {
  CUSTOMER
  FLEET_PARTNER
  MERCHANT_OWNER
  SUPPORT_AGENT
  ADMIN
}

/// A SUPERSET of every state any vertical can be in. Which of these a given
/// service may actually enter, and in what order, is defined per service in
/// `src/lib/orders/transitions.ts` — not by the ordering of this enum.
enum OrderStatus {
  // --- pre-dispatch (all services) ---
  DRAFT
  PENDING_PAYMENT

  // --- merchant leg (services whose lifecycle includes acceptance) ---
  PENDING_MERCHANT_ACCEPTANCE
  MERCHANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP

  // --- dispatch leg (all services that require a fleet partner) ---
  AWAITING_RIDER_ASSIGNMENT
  RIDER_ASSIGNED
  RIDER_AT_PICKUP

  // --- shopper leg (SHOPPER_TO_DOOR fulfilment) ---
  SHOPPING_IN_PROGRESS
  AWAITING_BUDGET_APPROVAL

  // --- passenger leg (PASSENGER fulfilment) ---
  PASSENGER_ONBOARD

  // --- transit leg ---
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DROPOFF

  // --- terminal ---
  DELIVERED
  DROPPED_OFF
  COMPLETED
  FAILED_DELIVERY
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_MERCHANT
  CANCELLED_BY_RIDER
  CANCELLED_BY_SYSTEM
}

/// Who moved the order into a state. Recorded on every status event so support
/// can reconstruct a timeline without guessing.
enum OrderActor {
  CUSTOMER
  MERCHANT
  FLEET_PARTNER
  SUPPORT_AGENT
  SYSTEM
}

/// Deliberately short. `WALLET_CREDIT` spends the credits ledger; there is no
/// stored-value instrument here and no card-on-file rail yet.
enum PaymentMethod {
  CASH_ON_DELIVERY
  WALLET_CREDIT
  /// Money moved to us out of band — a GCash, Maya or bank transfer the
  /// customer makes in their own app — and confirmed against a reference
  /// number by a human. Deliberately brand-free: which wallet it is, and the
  /// account it goes to, are configuration rather than a type.
  MANUAL_TRANSFER
}

/// Every way money can move on an order, as a row rather than a state.
///
/// Same discipline as `WalletTransactionType`: the events are the truth and
/// `Order.paymentStatus` is derived from them by `derivePaymentStatus()`. A
/// payment that is disputed months later needs to show what happened and
/// when, and a single mutable status column cannot.
///
/// Note what is absent: nothing here adds money to a credits balance. Cash
/// paid in refunds to the source it came from, never into credits, or the
/// no-top-up rule would have a way around it.
enum PaymentEventType {
  /// The customer chose a prepaid method. Nothing has moved yet.
  CHARGE_REQUESTED
  /// The customer says they have sent it, and gave us a reference to check.
  CHARGE_SUBMITTED
  /// The money is ours. A human checked the reference, or a provider said so.
  CHARGE_CONFIRMED
  /// The reference did not check out, or the provider declined it.
  CHARGE_REFUSED
  /// Nobody paid inside the window and the order was let go.
  CHARGE_EXPIRED
  /// Cash handed over at the door.
  CASH_COLLECTED
  /// Money sent back to wherever it came from.
  REFUND_ISSUED
}

/// Derived from an order's `PaymentEvent` rows by `derivePaymentStatus()`.
/// Never set by hand — it is a cache of the ledger, the way
/// `Wallet.balanceCentavos` is a cache of the credits ledger.
enum PaymentStatus {
  /// Nothing has happened. Money is owed and nobody has said otherwise.
  PENDING
  /// The customer says they have sent it and nobody has checked yet.
  ///
  /// Its own state rather than PENDING, and the distinction earns its keep:
  /// the expiry sweep cancels an unpaid order after twenty minutes, and a
  /// customer who has done their part must never be cancelled because WE were
  /// slow to look. Treating a claim as PENDING did exactly that.
  ///
  /// And not AUTHORIZED either. In payments that word means the issuer
  /// approved the funds; anybody can type thirteen digits into a box.
  CLAIMED
  /// Money arrived, and it is less than the total. Held rather than paid: the
  /// order keeps waiting and the customer is told what is missing, because
  /// calling ₱300 on a ₱324 order PAID leaves a shop out of pocket.
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  /// A reference that did not check out, or a window that closed.
  FAILED
}

/// The only five ways a credits balance can move. Note what is absent: there is
/// no TOP_UP, no TRANSFER_IN, no TRANSFER_OUT, and no WITHDRAWAL. That absence
/// is the product constraint, expressed in the type system.
enum WalletTransactionType {
  PROMO_CREDIT // granted by us (campaign, goodwill, credit-back benefit)
  REFUND // returned to the customer for a failed or cancelled order
  REFERRAL_BONUS // granted by us for a successful referral
  GIFT_CARD // granted by us, redeemed by whoever held the code
  ORDER_PAYMENT // spent on an order inside the app — the only debit customers cause
  ADJUSTMENT // signed correction, requires an admin actor and a reason
}

/// What someone may do in a store's back office.
enum StoreRole {
  /// Everything, including menu, prices and settings.
  OWNER
  /// Everything except removing other members.
  MANAGER
  /// Works the order queue. Cannot change prices or settings.
  STAFF
}

enum VehicleType {
  ON_FOOT
  BICYCLE
  MOTORCYCLE
  TRICYCLE
  CAR
  MPV
  VAN
}

/// Verification is tracked PER SERVICE. Approved to carry food is not approved
/// to carry a passenger.
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The life of a dispatch offer.
enum DispatchOfferStatus {
  /// Sent, still within its window.
  PENDING
  ACCEPTED
  DECLINED
  /// The window closed with no answer. Counts against acceptance rate.
  EXPIRED
  /// Somebody else took the order first. Does NOT count against anyone.
  SUPERSEDED
}

enum SubscriptionStatus {
  /// Enrolled, and the first period has not been paid for yet.
  ///
  /// Confers NOTHING — `getActiveSubscription` in the pricing engine accepts
  /// only ACTIVE, so a subscription in this state is invisible to checkout.
  /// It exists for the same reason `OrderStatus.PENDING_PAYMENT` does: a
  /// prepaid thing is not a thing until the money arrives, and a subscription
  /// that granted a month of free deliveries before anybody paid would be
  /// giving away the product to whoever tapped Subscribe.
  ///
  /// It DOES occupy the one-live-subscription slot, so somebody with an
  /// unpaid enrolment cannot start a second one.
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// How a subscription came to exist.
///
/// This is not decoration. A PAID subscription requires money to have changed
/// hands, and the app has no rail for that: `Order` payments are cash-on-delivery
/// or credits, and credits are spendable on orders only — by design, so they
/// cannot be turned into a subscription charge. Until a gateway exists, PAID
/// enrollment is refused at the door and the two grant origins are the only way
/// a subscription is created.
enum SubscriptionOrigin {
  /// Charged to a payment method. Needs a gateway; refused without one.
  PAID
  /// Given by us, deliberately, to a named person. Support goodwill, staff, a pilot.
  COMPED
  /// Given by a campaign — a launch cohort, a referral reward.
  PROMOTIONAL
}

/// Benefits are structured records the pricing engine reads, not marketing
/// copy. Each type uses a documented subset of the columns on
/// `SubscriptionBenefit`.
enum BenefitType {
  FREE_DELIVERY // uses minimumOrderCentavos + monthlyUsageCap
  DISCOUNT_PERCENT // uses percentBasisPoints + serviceKeys (+ optional cap)
  CREDIT_BACK_PERCENT // uses percentBasisPoints + monthlyCeilingCentavos
}

/// What a loyalty tier confers.
///
/// Two families in one enum, deliberately. The first three are the SAME three
/// `BenefitType` values a subscription plan uses, and they are priced by the
/// same `applyBenefits` — a tier is a second way to qualify for an existing
/// benefit, not a fourth discount mechanism. `billBenefitTypeFor` in
/// `lib/loyalty/tier-benefits.ts` maps them across, compile-enforced over every
/// value here, and returns null for the rest.
///
/// The last three touch no bill at all. They are what a status band can give
/// away without putting loyalty arithmetic anywhere near a checkout, and each
/// is read at exactly one seam: the dispatch fan-out, the support queue, and
/// the expiry stamped on an earned point.
enum TierBenefitType {
  /// uses minimumOrderCentavos + monthlyUsageCap
  FREE_DELIVERY
  /// uses percentBasisPoints + serviceKeys (+ optional maxDiscountCentavos)
  DISCOUNT_PERCENT
  /// uses percentBasisPoints + monthlyCeilingCentavos
  CREDIT_BACK_PERCENT
  /// uses priorityWeight. Offered to riders ahead of an equally old order.
  DISPATCH_PRIORITY
  /// uses priorityWeight. Sorted ahead of an equally old ticket.
  SUPPORT_PRIORITY
  /// uses no columns. Points earned at this tier are stamped with no expiry.
  POINTS_NEVER_EXPIRE
}

enum SupportTicketStatus {
  OPEN
  AWAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Where a snapshotted address sits in the job. Every order has exactly one of
/// each, whatever the vertical: food picks up at a store, a parcel picks up at
/// the sender, a ride picks up a passenger.
enum FulfilmentAddressRole {
  PICKUP
  DROPOFF
}

// -----------------------------------------------------------------------------
// 1. Service registry — each vertical defined as data
// -----------------------------------------------------------------------------

/// The registry. Every part of the product that needs to know something about a
/// vertical reads it from here. Seeded with all five services; only FOOD is
/// active. The other four exist as `isComingSoon` records so the home screen
/// can render them greyed with a "Coming soon" label — which doubles as demand
/// measurement before we build anything.
model Service {
  key         ServiceKey @id
  displayName String
  /// Short subtitle under the tile label, e.g. "Food delivery".
  tagline     String
  /// Icon identifier resolved by the client's icon map, not a file path, so the
  /// same row works for web and a future native client.
  icon        String
  description String

  intentGroup IntentGroup

  /// Tappable and orderable right now.
  isActive     Boolean @default(false)
  /// Rendered dimmed with a "Coming soon" label and NOT tappable.
  isComingSoon Boolean @default(true)
  sortOrder    Int

  fulfilmentType   FulfilmentType
  /// Whether an order in this vertical must reference a `Store`. Distinct from
  /// whether its lifecycle contains a merchant-acceptance step — that is a
  /// lifecycle question answered by `src/lib/orders/transitions.ts`.
  requiresMerchant Boolean
  /// Whether an order in this vertical must be assigned a `FleetPartner`.
  requiresRider    Boolean

  /// Cities where this service is orderable. Empty means "nowhere yet", which
  /// is the correct state for a coming-soon service.
  availableCityIds String[] @default([])

  /// Tailwind-ish colour token resolved by the client. Keeps per-service
  /// styling out of the components.
  accentToken String @default("brand")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  supportTickets   SupportTicket[]
  faqCategories    FaqCategory[]
  fleetApprovals   FleetPartnerServiceVerification[]
  deliveryFeeRules DeliveryFeeRule[]
  surgeBands       SurgeBand[]
  surgeSnapshots   SurgeSnapshot[]
  interest         ServiceInterest[]

  @@index([isActive, sortOrder])
  @@index([intentGroup, sortOrder])
}

/// Cities exist so `Service.availableCityIds` and address snapshots mean
/// something. Kept deliberately thin.
model City {
  id       String  @id
  name     String
  province String
  region   String
  isActive Boolean @default(true)

  centroidLat Float?
  centroidLng Float?

  addresses        Address[]
  stores           Store[]
  deliveryFeeRules DeliveryFeeRule[]
  serviceInterest  ServiceInterest[]
  surgeBands       SurgeBand[]
  surgeSnapshots   SurgeSnapshot[]

  @@index([isActive, name])
}

// -----------------------------------------------------------------------------
// 3. Unified identity and address book
// -----------------------------------------------------------------------------

/// ONE record per person, regardless of how many services they use or how many
/// roles they hold. A rider who orders lunch is this row twice over, not two
/// rows.
model User {
  id String @id @default(cuid())

  /// Philippine mobile number in E.164, e.g. +639171234567. The login identity.
  phone           String    @unique
  email           String?   @unique
  /// Set only when a code sent TO that address has been verified. An
  /// unverified email is worthless for recovery — anybody can type an address
  /// they do not control — so every recovery path checks this column, never
  /// `email` alone.
  emailVerifiedAt DateTime?
  /// NULL until the person tells us their name. A phone-first signup creates the
  /// record at the moment a code is verified, which is before they have typed
  /// anything else — pretending otherwise would put placeholder junk in the
  /// column and make every reader guess whether it is real.
  fullName        String?
  displayName     String?
  avatarUrl       String?
  /// Set the first time an OTP for this number is verified.
  phoneVerifiedAt DateTime?
  /// Set once the account has a name. Until then the app routes to /welcome.
  onboardedAt     DateTime?

  /// ROLES ARE AN ARRAY, not a single field. Someone can be a customer and a
  /// fleet partner simultaneously; the fleet works across every vertical it is
  /// approved for.
  roles UserRole[] @default([CUSTOMER])

  preferredCityId String?
  locale          String  @default("fil-PH")
  isBlocked       Boolean @default(false)

  /// This account's own invite code. Minted lazily — the first time somebody
  /// opens the invite screen — rather than at signup, because most accounts
  /// will never share one and a column full of unused codes is a column that
  /// makes collisions likelier for no benefit.
  ///
  /// Uppercase, from an alphabet with no O/0/I/1: a code is read off one
  /// phone screen and typed into another, and "was that an O or a zero" is a
  /// support ticket.
  referralCode String? @unique

  /// Written only by `prisma/seed.ts`. Demo rows exist so that a fresh clone
  /// has something to click; in production they are the single most dangerous
  /// thing in the database, because the seed uses real Philippine number
  /// formats and one of them holds ADMIN. Whoever owns that number in real
  /// life could otherwise request a login code and be an administrator.
  ///
  /// So the flag is not a label — it is load-bearing. A demo account cannot be
  /// signed into in production at all (see `src/lib/demo/policy.ts`), which
  /// means forgetting to purge is embarrassing rather than catastrophic.
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses               Address[]
  orders                  Order[]
  wallet                  Wallet?
  fleetPartner            FleetPartner?
  subscriptions           UserSubscription[]
  supportTickets          SupportTicket[]
  supportMessages         SupportTicketMessage[]
  assignedTickets         SupportTicket[]                   @relation("SupportAgentTickets")
  statusEvents            OrderStatusEvent[]
  recordedAdjustments     WalletTransaction[]               @relation("WalletAdjustmentActor")
  paymentEventsCaused     PaymentEvent[]                    @relation("PaymentEventActor")
  settlementEntries       SettlementEntry[]                 @relation("SettlementActor")
  sessions                Session[]
  storeMemberships        StoreMember[]
  grantedStoreAccess      StoreMember[]                     @relation("StoreAccessGranted")
  storeInvitesSent        StoreInvite[]                     @relation("StoreInvitesSent")
  storeInvitesAccepted    StoreInvite[]                     @relation("StoreInvitesAccepted")
  reviewsWritten          OrderReview[]
  fleetDecisions          FleetPartnerServiceVerification[] @relation("FleetVerificationDecider")
  menuImagesUploaded      MenuItemImage[]                   @relation("MenuImageUploader")
  storeImagesUploaded     StoreImage[]                      @relation("StoreImageUploader")
  grantedSubscriptions    UserSubscription[]                @relation("SubscriptionGrants")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       WebPushSubscription[]
  adminActions            AdminAuditEvent[]                 @relation("AdminAuditActor")
  recoveries              AccountRecovery[]
  assistedRecoveries      AccountRecovery[]                 @relation("RecoveryAssistedBy")
  serviceInterest         ServiceInterest[]
  errorReports            ErrorReport[]
  resolvedErrorReports    ErrorReport[]                     @relation("ErrorResolver")
  referralsMade           Referral[]                        @relation("ReferrerReferrals")
  referralReceived        Referral?                         @relation("RefereeReferral")
  loyaltyAccount          LoyaltyAccount?
  loyaltyAdjustments      LoyaltyEntry[]                    @relation("LoyaltyAdjustmentActor")
  /// A tier benefit's monthly cap is counted against the person, because a
  /// tier is not a row they pay for. Written by hand, like the one below.
  loyaltyBenefitUsages    LoyaltyBenefitUsage[]
  promoRedemptions        PromoRedemption[]
  promoCodesCreated       PromoCode[]                       @relation("PromoCodeCreator")
  giftCardsIssued         GiftCard[]                        @relation("GiftCardIssuer")

  /// Shop referrals this person attributed. Written by hand rather than left
  /// to `prisma format`, which would have named it `StoreReferral` — the same
  /// auto-generated shape that put two dead `fleetPartnerId` columns in this
  /// schema before anybody noticed.
  storeReferralsAttributed StoreReferral[]                  @relation("StoreReferralAttributor")
  giftCardsRedeemed       GiftCard[]                        @relation("GiftCardRedeemer")
  giftCardsVoided         GiftCard[]                        @relation("GiftCardVoider")
  invoicesSettled         SubscriptionInvoice[]             @relation("InvoiceSettler")

  @@index([roles], type: Gin)
  @@index([preferredCityId])
}

/// ONE address book per person, shared across every vertical. An address saved
/// while ordering food is immediately available as a parcel pickup.
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// User-chosen name: "Home", "Lola's house", "Office".
  label String

  line1         String
  line2         String?
  barangay      String?
  cityId        String
  city          City    @relation(fields: [cityId], references: [id])
  province      String
  postalCode    String?
  landmark      String?
  /// Free-text rider instructions: "green gate, ring twice".
  deliveryNotes String?

  latitude  Float
  longitude Float

  /// Contact at the address — not necessarily the account holder.
  contactName  String?
  contactPhone String?

  /// Some saved places make sense as origins, not just destinations. A parcel
  /// pickup or a ride start reads this.
  isPickupCapable Boolean @default(false)
  isDefault       Boolean @default(false)

  /// Maintained by `bumpAddressUsage()` in src/lib/addresses/usage.ts so the
  /// address picker can order by real behaviour rather than creation date.
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt, usageCount(sort: Desc)])
  @@index([userId, isPickupCapable])
  @@index([userId, lastUsedAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Authentication — one-time codes over SMS, opaque server-side sessions
// -----------------------------------------------------------------------------

/// A login session.
///
/// The cookie carries an opaque random token; this table stores only its SHA-256
/// hash, so a database dump does not hand over live sessions. Server-side rows
/// rather than a self-contained JWT because a session must be REVOCABLE — a
/// signed token that says "valid for 30 days" cannot be taken back.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie token, hex. Never the token itself.
  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  /// Bumped on use, so a stale session can be spotted and a sliding window
  /// extended without issuing a new token.
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  /// Coarse provenance for the "signed in on" list, and for spotting a session
  /// that suddenly moves. Truncated user agent and a HASHED ip — we do not need
  /// to keep the address itself to notice that it changed.
  userAgent String?
  ipHash    String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// A one-time code sent to a phone number.
///
/// Stores an HMAC of the code, not the code. A six-digit code has only a
/// million possibilities, so the HMAC is keyed with `AUTH_SECRET`: without the
/// secret a stolen database cannot be brute-forced back to live codes, and with
/// a five-minute expiry there is nothing much left to steal anyway.
model PhoneVerification {
  id    String @id @default(cuid())
  /// E.164, normalised before it ever reaches this table.
  phone String

  /// HMAC-SHA256(code, AUTH_SECRET), hex.
  codeHash String

  expiresAt  DateTime
  /// Failed verifications. The code dies at `MAX_VERIFY_ATTEMPTS`, so an online
  /// guess gets a handful of tries rather than a million.
  attempts   Int       @default(0)
  /// Single use: set the moment a code succeeds.
  consumedAt DateTime?

  /// Hashed requester address, for throttling bulk requests from one source
  /// without keeping a log of who asked.
  requestIpHash String?

  createdAt DateTime @default(now())

  /// Powers the per-phone throttle and "most recent code wins".
  @@index([phone, createdAt(sort: Desc)])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

/// A code sent to an email address.
///
/// Deliberately a separate table from `PhoneVerification` rather than one
/// table with a nullable phone and a nullable email. The two are different
/// enough in what they are for — one proves you hold the login identity, the
/// other proves you hold a recovery channel — that a shared table would need a
/// discriminator column and a CHECK constraint to stop rows meaning nothing.
/// The policy module is shared instead, which is where the logic actually is.
model EmailVerification {
  id String @id @default(cuid())

  /// Lower-cased and trimmed before it ever reaches this table.
  email String

  /// What the code is for. A code minted to confirm an address must not be
  /// usable to recover an account, and the other way round.
  purpose EmailCodePurpose

  /// HMAC-SHA256(code, AUTH_SECRET), hex. The plaintext is never stored.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  requestIpHash String?

  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt(sort: Desc)])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

enum EmailCodePurpose {
  /// Confirming an address the person typed while signed in.
  VERIFY_ADDRESS
  /// Proving control of a previously verified address, to move the phone.
  ACCOUNT_RECOVERY
}

// -----------------------------------------------------------------------------
// Merchants and catalogue (supporting cast for FOOD, reused later by MART)
// -----------------------------------------------------------------------------

model Store {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// A store can be orderable in more than one vertical — the same sari-sari
  /// store may serve MART now and FOOD later. Read this, do not assume FOOD.
  serviceKeys ServiceKey[] @default([])

  description String?
  logoUrl     String?
  coverUrl    String?

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  addressLine  String
  latitude     Float
  longitude    Float
  contactPhone String?

  isOpen    Boolean @default(true)
  isVisible Boolean @default(true)

  /// Written only by `prisma/seed.ts`. An invented restaurant with invented
  /// prices that a real customer can order from is a promise nobody will keep,
  /// so these are what `npm run db:purge-demo` removes alongside the accounts.
  isDemo Boolean @default(false)

  /// Merchant's own quoted prep time, snapshotted into FOOD order details at
  /// checkout so a later menu edit cannot rewrite history.
  preparationMinutes Int @default(20)

  /// What TARA keeps from this shop's food, in basis points of the subtotal.
  /// 250 = 2.5%.
  ///
  /// **Zero by default, and that is deliberate.** Commission is a negotiated
  /// term per partner, not a platform constant, and a non-zero default would
  /// invent revenue the moment settlement was switched on — quietly changing
  /// what every existing shop is owed. Set it per store, with a reason, from
  /// the console.
  ///
  /// It applies to the SUBTOTAL only. Never to the tip, which is the rider's
  /// entirely, and never to the delivery fee, which is what the rider is paid
  /// for the ride.
  commissionBasisPoints Int @default(0)

  /// DERIVED from `OrderReview`, never incremented. Recomputed from the rows
  /// inside the same transaction as the review that changed them — the same
  /// rule the credits ledger follows, for the same reason: an aggregate that
  /// drifts is one nobody can reconcile, and dispatch ranking reads it.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems         MenuItem[]
  images            StoreImage[]
  reviews           OrderReview[]
  members           StoreMember[]
  invites           StoreInvite[]
  settlementEntries SettlementEntry[]

  promoCodes PromoCode[]

  /// Shop-to-shop referrals, both directions. Like a rider's, a shop's
  /// referral pays MONEY through the settlement ledger — see `StoreReferral`.
  referralsMade    StoreReferral[] @relation("StoreReferrer")
  referralReceived StoreReferral?  @relation("StoreReferee")

  @@index([cityId, isVisible, isOpen])
  @@index([serviceKeys], type: Gin)
}

model MenuItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  category      String  @default("Main")
  priceCentavos Int

  /// What this normally costs, when it is on sale. Null means it is not.
  ///
  /// DISPLAY ONLY, and that is the whole safety argument: checkout prices
  /// every line from `priceCentavos`, so a wrong number here can make a dish
  /// look like a better deal than it is but can never charge anybody more.
  ///
  /// A database CHECK requires it to be strictly greater than the real price.
  /// A "was" price at or below what is being charged is not a discount, and a
  /// sale price is exactly the sort of field an import script writes badly.
  compareAtPriceCentavos Int?

  isAvailable   Boolean @default(true)
  sortOrder     Int     @default(0)

  /// When the shop marked this out of stock, cleared when it comes back.
  ///
  /// A separate column rather than reading `updatedAt`, because `updatedAt`
  /// moves for reasons that have nothing to do with stock: editing the price
  /// of an out-of-stock dish, or reordering the section it sits in, would
  /// each reset a duration derived from it. "Wala ngayon" is a claim about
  /// tonight, and the whole point of recording this is to notice when it is
  /// six weeks old.
  outOfStockSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The photo, if the shop has taken one. A row rather than a URL column:
  /// see `MenuItemImage`.
  image MenuItemImage?

  /// What a customer chooses when they order this: size, sawsawan, extra
  /// rice. Empty for most dishes, and a dish with no groups keeps its
  /// one-tap Add.
  optionGroups MenuItemOptionGroup[]

  @@index([storeId, isAvailable, sortOrder])
}

/// One question asked about a dish, and how many answers it takes.
///
/// The order side of this has existed since the first schema:
/// `FoodItemSnapshot.options` stores a chosen option's NAME and its price at
/// order time, and placement writes it. What did not exist was any way for a
/// shop to say what the choices ARE — so the field could only ever be empty,
/// which is the gap this closes.
///
/// `minChoices`/`maxChoices` is the whole grammar, and two settings cover
/// every real menu: (1,1) is "pick a size", (0,n) is "any add-ons you like".
/// A group with min 1 cannot be skipped, which is what stops an order arriving
/// at a kitchen without saying which size was wanted.
model MenuItemOptionGroup {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  /// "Size", "Sawsawan", "Add-ons". The question, in the shop's own words.
  name String

  /// How many of this group's options an order must and may carry.
  minChoices Int @default(0)
  maxChoices Int @default(1)

  sortOrder Int @default(0)

  options MenuItemOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuItemId, sortOrder])
}

/// One answer, and what it adds to the price.
///
/// `priceDeltaCentavos` is zero or positive, deliberately. A negative delta —
/// "without rice, ten pesos less" — is a different dish at a different price,
/// and the honest way to sell it is a second menu item, which a shop can now
/// create in three taps. Keeping the money one-directional means a line total
/// can never be argued down by a choice, and there is no floor to defend.
model MenuItemOption {
  id      String              @id @default(cuid())
  groupId String
  group   MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name               String
  priceDeltaCentavos Int     @default(0)
  /// Out of stock today, without deleting it. Same reason the dish itself has
  /// the flag: the pork runs out at lunch and comes back tomorrow.
  isAvailable        Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, sortOrder])
}

/// One photograph of one dish.
///
/// The bytes live HERE, in the same database as everything else, and that is
/// the same trade the error monitor makes against Sentry: it works on the
/// first deploy, with no bucket to create, no credentials to leak and no
/// third-party processor. What is given up is a CDN, which for a menu of tens
/// of images served with a long cache header is not yet a problem.
///
/// A `MenuItem.imageUrl` column existed and was never written to by anything —
/// which is the honest reason it is gone: a URL column is a promise that
/// somewhere is hosting the file, and nowhere was. `menu-images/<id>` is now
/// that promise, and the seam is one route handler wide, so putting the bytes
/// in object storage later is another adapter rather than a migration.
///
/// **Never `include: { image: true }`.** Prisma would select `bytes` with it,
/// so a list of forty dishes becomes forty photographs read into memory to
/// render a page that shows none of them. Every query here selects the id and
/// the dimensions and nothing else; the route handler is the only reader of
/// the bytes.
model MenuItemImage {
  id         String   @id @default(cuid())
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  /// Validated from the bytes themselves, never from what the client claimed.
  contentType String
  bytes       Bytes
  byteSize    Int
  width       Int
  height      Int

  /// Who uploaded it. Kept when they leave: the photo is the shop's, and a
  /// null author is better than losing the row.
  uploadedByUserId String?
  uploadedBy       User?   @relation("MenuImageUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which of a shop's two pictures this is.
enum StoreImageKind {
  /// Square-ish. The shop list, the order card, the top of the store page.
  LOGO
  /// Wide. The photograph behind the shop's name on its own page.
  BANNER
}

/// A shop's logo or banner, as bytes.
///
/// `Store.logoUrl` and `Store.coverUrl` are still the only thing any page
/// reads — an upload writes `/store-images/<id>` into one of them, so the
/// storefront needed no change at all when this arrived, and a shop whose
/// logo is hosted somewhere else keeps working.
///
/// This exists because those two columns took an ADDRESS, which quietly
/// assumed the picture was already on the internet. An operator holding a
/// JPEG the shop sent them over Viber had nowhere to put it, so in practice
/// no shop onboarded through the console ever got a logo.
///
/// Same bargain as `MenuItemImage`, for the same reasons: bytes in Postgres,
/// no bucket to create and no credentials to rotate, served with a year-long
/// immutable cache. Two pictures per shop at 400 KB is a rounding error next
/// to the menu.
model StoreImage {
  id      String         @id @default(cuid())
  storeId String
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind    StoreImageKind

  /// Validated from the bytes themselves, never from what the client claimed.
  contentType String
  bytes       Bytes
  byteSize    Int
  width       Int
  height      Int

  /// Who uploaded it. Kept when they leave: the picture is the shop's.
  uploadedByUserId String?
  uploadedBy       User?   @relation("StoreImageUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One of each per shop, replaced rather than versioned.
  @@unique([storeId, kind])
}

// -----------------------------------------------------------------------------
// Delivery pricing — rates as data
// -----------------------------------------------------------------------------

/// Distance-based delivery pricing, per service and per city.
///
/// These are rates ops will want to tune weekly. Putting them in code would
/// mean a deploy to change a fee, so they live here: `quoteDeliveryFee()` reads
/// this table and contains no numbers of its own. A city with no rule for a
/// service simply cannot be quoted, which is the correct failure — better than
/// silently applying a Manila rate in Cebu.
/// One step of a surge ladder: "at this much unmet demand, add this much".
///
/// Keyed exactly like `DeliveryFeeRule` — service plus an optional city, where
/// a city-specific set beats the fallback — because a Friday night in Manila
/// and a Tuesday in a small city are not the same market and should not share
/// a number.
///
/// **Steps rather than a multiplier.** A continuous multiplier moves the fee on
/// every page refresh: a customer sees ₱43.17, then ₱44.02, and concludes the
/// price is being made up. A step is explainable to both sides of the market —
/// "when it is busy, riders get ₱20 more" — and it holds still long enough to
/// be quoted.
///
/// **There are no rows by default, and that means surge is off.** The same
/// discipline as a commission of zero: a default ladder would have started
/// charging customers more the moment this shipped.
model SurgeBand {
  id String @id @default(cuid())

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  /// Null means "every city where the service is live" — a fallback ladder.
  /// A city's own ladder always wins, and wins ENTIRELY: the two are never
  /// merged, because half of one ladder and half of another is a ladder nobody
  /// designed.
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  /// Orders waiting for a rider, per rider available, at or above which this
  /// step applies. 1.5 means "three orders waiting for every two free riders".
  minOrdersPerRider Float

  /// Added to the delivery fee, and paid ENTIRELY to the rider. Capped in
  /// `prisma/sql/surge.sql` — a surge larger than most orders' whole fee is a
  /// typo, and a typo here overcharges a customer.
  surgeCentavos Int

  /// Shown to the customer and the rider: "Busy", "Very busy". The reason
  /// attached to the money, because a fee with no name reads as a mistake.
  label String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One step per threshold per service per city.
  @@unique([serviceType, cityId, minOrdersPerRider])
  @@index([serviceType, isActive])
}

/// What the market looked like when surge was last measured.
///
/// Surge is computed by the maintenance cron and READ from here by quotes,
/// rather than measured during a quote. Three reasons, all of them about not
/// lying to somebody:
///
///   1. **A quote and the placement that follows it agree.** Checkout re-quotes
///      before placing, so a live measurement could show ₱39 and charge ₱59
///      seconds later. Reading a snapshot means the figure holds still.
///   2. **There is no client input to tamper with.** The alternative — trusting
///      a quoted surge posted back by the browser — lets anybody send zero.
///   3. **Every charge can be explained afterwards.** The inputs are on the
///      row: at 19:32, Manila had 7 orders waiting and 3 riders free, so the
///      ladder said Busy and ₱20.
///
/// Append-only in spirit and in the guard: a history of what the market did is
/// worth having when a customer asks why their fee was higher last Friday.
model SurgeSnapshot {
  id String @id @default(cuid())

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Orders in the dispatch queue with nobody assigned.
  ordersWaiting   Int
  /// Riders online, approved for this service, not suspended, and not already
  /// carrying an order.
  ridersAvailable Int
  /// `ordersWaiting / ridersAvailable`, or the orders count when there are no
  /// riders at all — see `ordersPerRider()`.
  ratio           Float

  /// The step that applied, and what it added. Null label means no step
  /// matched and no surge was charged.
  surgeCentavos Int     @default(0)
  bandLabel     String?

  createdAt DateTime @default(now())

  /// Read by every quote: the newest row for this service and city.
  @@index([serviceType, cityId, createdAt(sort: Desc)])
}

model DeliveryFeeRule {
  id String @id @default(cuid())

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  /// Null means "every city where the service is live" — a fallback rule.
  /// A city-specific rule always wins over the fallback.
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  /// Charged before any distance.
  baseFeeCentavos      Int
  /// Distance included in the base fee, metres.
  includedMeters       Int  @default(0)
  /// Per kilometre beyond `includedMeters`, charged pro rata.
  perKilometreCentavos Int
  /// Floor and ceiling on the computed fee.
  minimumFeeCentavos   Int  @default(0)
  maximumFeeCentavos   Int?

  /// Subtotal at or above which delivery is free regardless of distance. Null
  /// disables the threshold. Distinct from the subscription FREE_DELIVERY
  /// benefit: this one applies to everybody.
  freeAboveSubtotalCentavos Int?

  /// Charged when the subtotal is below `smallOrderThresholdCentavos`.
  smallOrderThresholdCentavos Int?
  smallOrderFeeCentavos       Int  @default(0)

  /// Flat platform fee for this service/city.
  serviceFeeCentavos Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One rule per service per city, plus one fallback per service.
  @@unique([serviceType, cityId])
  @@index([serviceType, isActive])
}

/// Who may work a store's back office.
///
/// A join table rather than an owner column on `Store`, because the real shape
/// is many-to-many in both directions: a karinderya owner works the queue
/// alongside two staff, and a small chain owner holds several stores. An owner
/// column would force a second source of truth the first time either happened.
///
/// Store access is granted HERE and nowhere else. `User.roles` carrying
/// MERCHANT_OWNER says what kind of person someone is; this table says which
/// stores they may actually touch, which is the question every merchant action
/// has to answer.
model StoreMember {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role StoreRole @default(STAFF)

  /// Who granted this access. NULL for the seed and for the rows that predate
  /// the invite screen. SetNull rather than Cascade: deleting the person who
  /// did the inviting must not delete the access they granted, or removing one
  /// account would quietly lock a store's whole staff out.
  invitedById String?
  invitedBy   User?   @relation("StoreAccessGranted", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([userId])
}

/// One review per completed order.
///
/// ONE ROW, not one per subject. An order is a single experience the customer
/// had, and they rate it once — the food and the delivery are two scores on
/// that one event rather than two events. `@@unique` on `orderId` makes rating
/// the same order twice unrepresentable rather than merely discouraged.
///
/// Both scores are OPTIONAL, and which ones apply comes from the registry: a
/// vertical with no merchant leg has no store to rate, and an order nobody was
/// dispatched to has no partner. Nothing here knows which services exist.
///
/// TWO PRIVACY RULES, both enforced in `lib/ratings/reviews.ts` rather than
/// here, and both deliberate:
///
///   - The COMMENT is never shown publicly. A free-text review on a shop page
///     is a moderation burden and a defamation risk; the same text is worth a
///     great deal to the operator and the merchant. So it is collected and
///     shown to them, and the storefront shows stars only.
///   - The AUTHOR is never shown to the store or the partner. A rider who can
///     see who gave them one star also knows that person's address. Only an
///     administrator sees who wrote what.
model OrderReview {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// SNAPSHOTTED from the order, not read through it. The store lives in the
  /// order's `details` JSON, and an aggregate query cannot join through that.
  /// SetNull rather than Cascade: deleting a shop must not erase the rider's
  /// half of the same review.
  storeId    String?
  store      Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeStars Int?

  fleetPartnerId String?
  fleetPartner   FleetPartner? @relation(fields: [fleetPartnerId], references: [id], onDelete: SetNull)
  partnerStars   Int?

  /// Not shown on the storefront. See the note above.
  comment String?

  /// When the shop and the partner were told about this, SEPARATELY, because
  /// the two are notified independently: a review that rates only the food has
  /// no partner to tell.
  ///
  /// Two timestamps rather than one flag because the notification is a DIGEST
  /// — one message per subject covering everything since the last one — so the
  /// sweep needs to know which rows a given digest has already covered. Same
  /// shape as `ServiceInterest.notifiedAt`.
  storeNotifiedAt   DateTime?
  partnerNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The aggregate recomputes read these, and the merchant and fleet screens
  /// list them newest first.
  @@index([storeId, createdAt(sort: Desc)])
  @@index([fleetPartnerId, createdAt(sort: Desc)])
  @@index([authorId])
  /// The digest sweep: un-notified rows, oldest first, per subject.
  @@index([storeNotifiedAt, createdAt])
  @@index([partnerNotifiedAt, createdAt])
}

/// An offer of store access to a PHONE NUMBER rather than to an account.
///
/// This model exists because of one fact: the person a store owner wants to
/// add usually has not signed up yet. The alternatives were both worse —
/// fabricating an account for a number nobody has verified, or telling the
/// owner to come back after their staff have registered.
///
/// Redeemed on sign-in, in `checkLoginCode`, because that is the moment the
/// OTP has proved control of the number. An invite is therefore a grant to
/// whoever holds the SIM, which is why it EXPIRES: Philippine numbers get
/// recycled, and a two-year-old invite to a reassigned number would hand a
/// stranger the order queue.
model StoreInvite {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// E.164, normalised on the way in. Deliberately NOT a user id.
  phone String
  role  StoreRole @default(STAFF)

  invitedById String
  invitedBy   User   @relation("StoreInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("StoreInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One invite per number per store. Re-inviting UPDATES the existing row —
  /// a new expiry, a new role, revocation cleared — rather than leaving a
  /// pile of dead rows nobody can read.
  @@unique([storeId, phone])
  /// The redemption lookup on every sign-in: by number, unaccepted only.
  @@index([phone, acceptedAt])
}

// -----------------------------------------------------------------------------
// 2. Unified order model — one table for every vertical
// -----------------------------------------------------------------------------

/// The base record for EVERY vertical. Shared concerns are columns here;
/// vertical-specific concerns live in `details`.
model Order {
  id          String @id @default(cuid())
  /// Human-facing reference, shown in support and receipts.
  orderNumber String @unique

  /// References `Service.key`. The FK is what makes "unknown vertical"
  /// unrepresentable.
  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  status OrderStatus @default(DRAFT)

  /// Exactly two rows per order: one PICKUP, one DROPOFF. Each is a full
  /// snapshot taken at placement — editing the address book never rewrites a
  /// past order.
  addresses OrderAddress[]

  // --- fee breakdown, all in CENTAVOS (integer). Never store money as float.
  subtotalCentavos             Int     @default(0)
  deliveryFeeCentavos          Int     @default(0)
  serviceFeeCentavos           Int     @default(0)
  smallOrderFeeCentavos        Int     @default(0)
  surgeCentavos                Int     @default(0)
  /// The name of the surge band that produced `surgeCentavos` — "Busy", "Very
  /// busy" — copied onto the order at placement rather than looked up later.
  ///
  /// Because a receipt has to stay readable after the bands are edited or
  /// deleted, and after the snapshot it was priced from has been pruned. A
  /// receipt that reads "Surge ₱20" with no reason is exactly the unexplained
  /// fee the labels exist to prevent, and the only moment the reason is
  /// certainly available is the moment the charge is made.
  surgeLabel                   String?
  tipCentavos                  Int     @default(0)
  /// Promo/voucher discount, stored positive and subtracted.
  promoDiscountCentavos        Int     @default(0)
  /// Discount attributable to an active subscription benefit, kept separate so
  /// we can measure what the tier actually costs us.
  subscriptionDiscountCentavos Int     @default(0)
  /// Discount attributable to a LOYALTY TIER benefit.
  ///
  /// Its own column rather than a share of the one above, and the reason is
  /// the receipt. A customer who has never paid for Plus, reading "Plus
  /// benefits −₱49" on their bill, has been told something false about why
  /// their delivery was free — and an operator asking what Plus costs would
  /// be reading a figure that includes people who do not subscribe.
  ///
  /// Settlement treats it identically: `splitOrderValue` absorbs it against
  /// the platform's share, because the shop still gets its subtotal and the
  /// rider still gets the fee somebody was not charged.
  loyaltyDiscountCentavos      Int     @default(0)
  /// Credits spent on this order. Mirrors the ORDER_PAYMENT ledger entry.
  walletCreditAppliedCentavos  Int     @default(0)
  /// What the customer owes after everything above.
  totalCentavos                Int     @default(0)
  currency                     String  @default("PHP")

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  /// Field name kept as `assignedRiderId` per the shared-field contract even
  /// though the fleet model is service-neutral.
  assignedRiderId String?
  assignedRider   FleetPartner? @relation(fields: [assignedRiderId], references: [id])

  /// Vertical-specific payload. Shape is validated per service key by
  /// `parseOrderDetails()` in src/lib/orders/details.ts. Only the FOOD shape is
  /// implemented; the other four are documented placeholders.
  details Json @default("{}")

  // --- timestamps ---
  placedAt    DateTime?
  acceptedAt  DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  /// Best current estimate shown on the tracking screen.
  etaAt       DateTime?

  cancellationReason String?
  cancelledBy        OrderActor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review             OrderReview?
  statusEvents       OrderStatusEvent[]
  dispatchOffers     DispatchOffer[]
  walletTransactions WalletTransaction[]
  paymentEvents      PaymentEvent[]
  settlementEntries  SettlementEntry[]
  supportTickets     SupportTicket[]
  appliedBenefits    OrderAppliedBenefit[]
  notifications      Notification[]
  loyaltyEntries     LoyaltyEntry[]
  promoRedemption    PromoRedemption?

  /// The referrals this order qualified — a customer's first order paying
  /// their referrer's credits, and a rider's Nth delivery paying a partner
  /// bonus. Named rather than left as Prisma's auto-generated `Referral` /
  /// `LoyaltyEntry`, which read as models rather than as what an order has.
  referralsQualified        Referral[]
  partnerReferralsQualified PartnerReferral[]

  /// Powers the unified cross-service order history: one chronological list,
  /// every vertical, no per-service queries.
  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerId, status])
  @@index([serviceType, status])
  @@index([assignedRiderId, status])
  @@index([status, createdAt])
}

/// A full address snapshot bound to an order. Denormalised on purpose: an order
/// must remain readable years later even if the source `Address` row is edited
/// or deleted.
model OrderAddress {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  role FulfilmentAddressRole

  /// Where this snapshot came from, when it came from the address book at all.
  /// Nullable because a store pickup or a map-pin dropoff has no book entry.
  sourceAddressId String?

  label         String?
  line1         String
  line2         String?
  barangay      String?
  cityId        String
  cityName      String
  province      String
  postalCode    String?
  landmark      String?
  deliveryNotes String?

  latitude  Float
  longitude Float

  contactName  String?
  contactPhone String?

  createdAt DateTime @default(now())

  @@unique([orderId, role])
  @@index([cityId])
}

/// Append-only audit of every status change, written by the state machine. Also
/// what the tracking screen renders as a timeline.
model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actor       OrderActor
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id])
  reason      String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// -----------------------------------------------------------------------------
// 4. Unified fleet — service-neutral, per-service approval
// -----------------------------------------------------------------------------

/// Formerly `RiderProfile`. Renamed because the same person will eventually
/// deliver food, carry parcels, and possibly drive passengers, and a name that
/// says "rider" invites food-shaped assumptions.
model FleetPartner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which services this partner is APPROVED to work. Dispatch builds its
  /// candidate list from this array; everything else about ranking is unchanged.
  /// Derived from `serviceVerifications` — kept denormalised because dispatch
  /// reads it on every candidate query.
  enabledServices ServiceKey[] @default([])

  vehicleType  VehicleType
  vehiclePlate String?
  vehicleModel String?
  /// Insulated bag, top box, child seat, etc. Some services will require some
  /// of these; that requirement belongs in config, not here.
  equipment    String[]    @default([])

  homeCityId String?

  isOnline    Boolean @default(false)
  isSuspended Boolean @default(false)

  /// Whether to be told when this partner's city goes busy — see
  /// `NotificationKind.SURGE_ACTIVE`.
  ///
  /// Lives here rather than in `NotificationPreference` because that table is
  /// keyed by CHANNEL, and the choice a rider needs to make is about a kind:
  /// declining an invitation to work should not also mute the message saying an
  /// order is waiting for them. A general per-kind preference table would have
  /// exactly one row worth setting — this is the only kind in the system that
  /// asks somebody to do something rather than telling them something happened
  /// — so it is one column on the party it concerns.
  ///
  /// On by default. A rider who has not thought about it is better served
  /// hearing that tonight pays more, and one tap turns it off.
  wantsBusyAlerts Boolean @default(true)

  currentLatitude   Float?
  currentLongitude  Float?
  locationUpdatedAt DateTime?

  /// DERIVED from `OrderReview`. See the note on `Store.ratingAvg`; this pair
  /// is the one dispatch ranking actually scores on, so a stale value quietly
  /// misroutes work.
  ratingAvg           Float @default(0)
  ratingCount         Int   @default(0)
  completedOrderCount Int   @default(0)
  acceptanceRate      Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews OrderReview[]

  serviceVerifications FleetPartnerServiceVerification[]
  orders               Order[]
  dispatchOffers       DispatchOffer[]
  settlementEntries    SettlementEntry[]

  /// Rider referrals, both directions. A partner referral pays MONEY through
  /// the settlement ledger rather than credits — see `PartnerReferral`.
  referralsMade     PartnerReferral[] @relation("PartnerReferrer")
  referralReceived  PartnerReferral?  @relation("PartnerReferee")

  @@index([isOnline, isSuspended, homeCityId])
  @@index([enabledServices], type: Gin)
}

/// Verification status held PER SERVICE. A partner approved for food delivery
/// is not automatically approved to carry passengers, and this table is where
/// the model says so out loud.
model FleetPartnerServiceVerification {
  id             String       @id @default(cuid())
  fleetPartnerId String
  fleetPartner   FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)

  serviceType ServiceKey
  service     Service    @relation(fields: [serviceType], references: [key])

  status VerificationStatus @default(NOT_SUBMITTED)

  /// Document identifiers required for THIS service (e.g. a professional
  /// driver's licence for RIDE, a food-handler card for FOOD).
  submittedDocuments String[] @default([])

  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation("FleetVerificationDecider", fields: [decidedByUserId], references: [id])
  rejectionReason String?
  expiresAt       DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fleetPartnerId, serviceType])
  @@index([serviceType, status])
}

/// An order offered to one fleet partner.
///
/// Offers are records rather than a transient push, for two reasons. It makes
/// `FleetPartner.acceptanceRate` mean something — without a row saying "this
/// was offered and went unanswered" that column is decorative. And it makes
/// the race safe: several partners can hold a PENDING offer for the same order,
/// and the first to accept wins on the state machine's optimistic guard while
/// the rest are SUPERSEDED rather than penalised.
model DispatchOffer {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fleetPartnerId String
  fleetPartner   FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Cascade)

  status DispatchOfferStatus @default(PENDING)

  /// Position in the ranked candidate list when the offer was made, and the
  /// distance it was ranked on. Kept so a dispatch decision can be reviewed
  /// after the partners have moved.
  rank           Int
  distanceMeters Int

  offeredAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())

  /// One offer per partner per order: re-offering the same job to the same
  /// person is how an acceptance rate gets quietly destroyed.
  @@unique([orderId, fleetPartnerId])
  @@index([fleetPartnerId, status, expiresAt])
  @@index([orderId, status])
  @@index([status, expiresAt])
}

// -----------------------------------------------------------------------------
// 5. Credits — a ledger, and nothing else
// -----------------------------------------------------------------------------
// HARD CONSTRAINTS, enforced in src/lib/wallet/ledger.ts and by the SQL guard
// in prisma/sql/wallet_append_only.sql:
//   * No top-up. A customer cannot add their own cash to a balance.
//   * No transfers between users.
//   * No withdrawal or cash-out.
//   * Balance can only be spent on orders inside the app.
// Surfaced in the UI as "Credits" / "Rewards" — never "wallet" or "e-money".
// -----------------------------------------------------------------------------

/// One per user. `balanceCentavos` is a DERIVED CACHE of the ledger sum, written
/// only by `recordWalletTransaction()`. Never update it directly.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived: sum(transactions.amountCentavos). The ledger is the truth.
  balanceCentavos Int    @default(0)
  currency        String @default("PHP")

  /// Blocks spending without deleting history, e.g. during a fraud review or
  /// the cooling-off period after the account's phone number changed.
  isFrozen     Boolean   @default(false)
  frozenReason String?
  /// When the freeze lifts on its own. NULL means indefinite — a fraud review
  /// ends when somebody ends it. Set for the recovery cooling-off period,
  /// which is the whole reason recovery is not a way to steal a balance:
  /// taking over an account buys you credits you cannot spend for three days,
  /// by which time the alert has reached the real owner.
  frozenUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

/// APPEND-ONLY ledger. Every balance change is a row here, written by exactly
/// one backend function. There is no UPDATE or DELETE path in application code,
/// and the SQL guard rejects both at the database level.
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type WalletTransactionType

  /// SIGNED amount in centavos. Credits are positive, ORDER_PAYMENT is
  /// negative, ADJUSTMENT may be either. The sign is forced by `type` in
  /// `recordWalletTransaction()`, never supplied by a caller.
  amountCentavos Int

  /// The recomputed ledger sum immediately after this row. Lets us detect
  /// drift: a replay of the ledger must reproduce every value in this column.
  balanceAfterCentavos Int

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id])

  /// Customer-visible line in the credits history.
  description String

  /// Set for ADJUSTMENT rows: which admin made the correction.
  adminUserId String?
  adminUser   User?   @relation("WalletAdjustmentActor", fields: [adminUserId], references: [id])

  /// Makes granting idempotent — a retried promo campaign cannot double-credit.
  idempotencyKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  /// The points redemption this row came from, when it did. Back-reference to
  /// the loyalty ledger, so a credit granted from points can be traced to the
  /// points it consumed without a join through metadata.
  loyaltyRedemption LoyaltyEntry?

  /// Note the absence of `updatedAt`. This table is not updated.
  @@index([walletId, createdAt(sort: Desc)])
  @@index([relatedOrderId])
  @@index([type, createdAt])
}

/// APPEND-ONLY record of money moving on an order.
///
/// The credits ledger's twin, and for the same reason: money needs a history,
/// not a status. `Order.paymentStatus` is a derived cache of these rows the way
/// `Wallet.balanceCentavos` is a derived cache of the ledger, computed by
/// `derivePaymentStatus()` in src/lib/payments/policy.ts. If the two ever
/// disagree, these rows are right.
///
/// The two ledgers are deliberately separate tables. Credits are an internal
/// balance that only we grant and only orders can spend; this is real money
/// arriving from outside. Keeping them apart is what makes "cash can never
/// become credits" checkable rather than a convention — there is no schema
/// path from a confirmed charge here to a row over there.
model PaymentEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  type PaymentEventType

  /// Which instrument this event is about. Copied onto the row rather than
  /// read from the order, because an order's method can be corrected by
  /// support and these rows must keep saying what was true when they happened.
  method PaymentMethod

  /// Which rail handled it: `manual` for a transfer a person confirmed. A
  /// provider key when one is wired. A string rather than an enum so adding a
  /// provider is configuration, not a migration.
  provider String @default("manual")

  /// SIGNED centavos. Money in is positive, money out negative, and an event
  /// that moves nothing is zero. The sign is forced by `type` in
  /// `signedPaymentAmount()` and never supplied by a caller — the same rule
  /// that stops a refund being booked as a charge in the credits ledger.
  amountCentavos Int    @default(0)
  currency       String @default("PHP")

  /// What the customer typed, or the provider's own id for the transaction.
  /// Not unique: a customer mistyping a reference and correcting it leaves two
  /// rows, and both are part of what happened.
  reference String?

  /// Why, in words somebody can act on. Mandatory for a refusal — the
  /// customer is shown it, and "no" with no reason is unanswerable.
  note String?

  /// Who caused it: the customer submitting a reference, or the admin who
  /// confirmed or refused. NULL for events the system authored, like an
  /// expiry.
  actorUserId String?
  actorUser   User?   @relation("PaymentEventActor", fields: [actorUserId], references: [id])

  /// Makes confirmation idempotent. A provider that retries a webhook, or an
  /// admin double-tapping Confirm, must not charge or refund twice.
  idempotencyKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  /// Note the absence of `updatedAt`. This table is not updated.
  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([reference])
}

/// Which side of TARA a settlement row belongs to.
enum SettlementParty {
  STORE
  FLEET_PARTNER
}

/// Every way a balance with a partner can move.
///
/// The signs are the thing to hold on to. A balance here is **what TARA owes
/// the partner**: positive means we owe them, negative means they are holding
/// our money. A rider on a cash order earns ₱39 and collects ₱399 at the door,
/// so their balance goes to −₱360 — they owe us. That is not an edge case, it
/// is what every cash order does, and it is the whole reason this ledger nets
/// rather than just accumulating.
enum SettlementEntryType {
  /// What a partner earned on an order that completed. Always positive.
  ORDER_EARNINGS
  /// A rider took the customer's money at the door. Negative: it is ours.
  CASH_COLLECTED
  /// We sent them money. Negative — it discharges what we owed.
  PAYOUT_SENT
  /// They handed our cash back. Positive — it discharges what they owed.
  CASH_REMITTED
  /// A referral bonus a partner earned by bringing another partner. Positive,
  /// written by the system, and deliberately NOT tied to an order: it arises
  /// from somebody else's delivery, and a line on this rider's statement
  /// naming an order they did not deliver would be a lie on the one screen
  /// they read. The qualifying delivery is on the `PartnerReferral` row.
  ///
  /// It is an accrual, not a payment. The money joins what TARA owes them and
  /// leaves in the payout somebody records — which is the whole reason this is
  /// a settlement entry rather than a new rail.
  REFERRAL_BONUS
  /// A signed correction. Requires an admin and a reason, and exists because
  /// the real world produces cases no rule anticipated — a rider who paid a
  /// store directly, a damaged order somebody absorbed.
  ADJUSTMENT
}

/// APPEND-ONLY ledger of what TARA owes its partners, and what they owe TARA.
///
/// The third ledger, and the one that finally connects the other two to the
/// people doing the work. `WalletTransaction` is credits we granted;
/// `PaymentEvent` is money customers moved; this is money owed between TARA
/// and the shops and riders. Same discipline as both: append-only, sign forced
/// by type, one write function, a reason required where a human decided.
///
/// **Unlike the other two, the balance is NOT cached.** `Wallet` caches its
/// balance because spending has to check it atomically before allowing a
/// debit; nothing here is blocked on a balance in that way, so a summed query
/// is cheaper than a cached column that can drift. A payout does check the
/// balance, and reads the sum inside its own transaction.
model SettlementEntry {
  id String @id @default(cuid())

  party SettlementParty

  /// Exactly one of these is set, enforced by a CHECK in
  /// `prisma/sql/settlement_append_only.sql`. Real foreign keys rather than a
  /// polymorphic id, because this table is money and a row pointing at a
  /// partner who does not exist is not a row anybody can settle.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  fleetPartnerId String?
  fleetPartner   FleetPartner? @relation(fields: [fleetPartnerId], references: [id])

  type SettlementEntryType

  /// SIGNED centavos, from TARA's point of view: positive means we owe the
  /// partner more, negative means we owe them less. Forced by `type` in
  /// `signedSettlementAmount()` and never supplied by a caller — the same rule
  /// both other ledgers follow, because a caller who picks the sign can book a
  /// payout as an earning.
  amountCentavos Int
  currency       String @default("PHP")

  /// The order this arose from, for earnings and cash collection. NULL for a
  /// payout or a remittance, which settle many orders at once.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// Partner-visible line in their statement.
  description String

  /// Required for a payout, a remittance and an adjustment: each is a person
  /// asserting that money moved in the real world, and a claim with no
  /// reference is one nobody can check later.
  reference String?

  /// Who recorded it. NULL for accruals, which the system writes on
  /// completion; set for everything a human did.
  actorUserId String?
  actorUser   User?   @relation("SettlementActor", fields: [actorUserId], references: [id])

  /// Makes accrual idempotent: keyed to the order and the party, so a
  /// completion that runs twice pays once.
  idempotencyKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  /// Note the absence of `updatedAt`. This table is not updated.
  @@index([storeId, createdAt])
  @@index([fleetPartnerId, createdAt])
  @@index([party, type])
  @@index([orderId])
}

// -----------------------------------------------------------------------------
// 6. Subscription tier
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  tagline              String?
  monthlyPriceCentavos Int
  currency             String  @default("PHP")

  /// Seeded plan ships INACTIVE. Flip this when we decide to launch.
  isActive  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The benefits array. Structured records the pricing engine reads.
  benefits      SubscriptionBenefit[]
  subscriptions UserSubscription[]

  @@index([isActive, sortOrder])
}

/// One structured benefit. Which columns are meaningful depends on `type`:
///   FREE_DELIVERY       -> minimumOrderCentavos, monthlyUsageCap
///   DISCOUNT_PERCENT    -> percentBasisPoints, serviceKeys, maxDiscountCentavos
///   CREDIT_BACK_PERCENT -> percentBasisPoints, monthlyCeilingCentavos
/// `src/lib/pricing/checkout.ts` validates that pairing before applying it.
/// One month's bill for one subscription.
///
/// ### Why this exists at all
///
/// Before it, a subscription had a `renewsAt` and nothing else: no record of
/// what was owed for which period, so there was nothing to chase, nothing to
/// reconcile, and nothing for the three-day PAST_DUE grace to actually grace.
/// That gap is provider-independent — a card gateway, an e-wallet mandate and
/// a bank transfer all need the same answer to "what does this person owe for
/// September, and did it arrive".
///
/// ### The two halves of a settlement
///
/// A customer SUBMITS a reference ("I sent it, ref 1234567890") and somebody
/// then CONFIRMS it. Those are separate columns because they are separate
/// facts with separate authors — exactly the split `PaymentEvent` makes for an
/// order with CHARGE_SUBMITTED and CHARGE_CONFIRMED. A refusal clears the
/// submission so the customer can send a corrected reference.
///
/// ### What it does not model
///
/// No partial payments and no proration. A monthly fee is paid or it is not,
/// and cancelling runs to the end of the period already bought rather than
/// refunding part of it. Both are deliberate omissions rather than oversights:
/// proration needs a refund rail, and there is no refund rail for a
/// subscription because there is no charge rail yet either.
model SubscriptionInvoice {
  id String @id @default(cuid())

  subscriptionId String
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Human-quotable, and what the customer is asked to put in the transfer
  /// note. It is what makes an unmatched payment findable later.
  reference String @unique

  /// The period this invoice buys. Stamped at issue, so the customer can see
  /// what they are paying for before they pay.
  ///
  /// A LATE settlement does not rewrite these: the subscription's own
  /// `renewsAt` becomes one period from the moment the money arrived, so
  /// somebody who pays three days late gets a full month rather than a stub.
  /// The invoice therefore records what was offered and `renewsAt` records
  /// what they have — see `nextRenewsAt` in lib/subscriptions/billing-policy.
  periodStart DateTime
  periodEnd   DateTime

  /// COPIED from the plan at issue, never read through the relation.
  ///
  /// This is the point of the column. Raising the plan price must not change
  /// what somebody already owes for a period they were quoted — a bill that
  /// rewrites itself is not a bill. The immutability trigger in
  /// prisma/sql/subscription_invoices.sql makes that true at the database
  /// level too.
  amountCentavos Int
  currency       String @default("PHP")

  issuedAt DateTime @default(now())
  dueAt    DateTime

  /// How many times collection has been attempted and failed — a provider
  /// declining, or an administrator refusing a reference that did not check
  /// out. Drives the dunning ladder.
  attemptCount      Int       @default(0)
  lastAttemptAt     DateTime?
  lastFailureReason String?

  /// The customer's claim, before anybody has checked it.
  submittedAt        DateTime?
  submittedReference String?

  /// Set together, or not at all — see `subscription_invoice_settlement_is_complete`.
  settledAt        DateTime?
  /// Which rail settled it: `manual` for a transfer a person confirmed, a
  /// provider key when one is wired. A string rather than an enum so adding a
  /// provider is configuration, not a migration — the same choice
  /// `PaymentEvent.provider` makes.
  settledVia       String?
  /// The reference that was accepted, or the provider's own transaction id.
  settledReference String?
  /// The administrator who confirmed it. NULL when a provider did, and NULL
  /// after a lawful purge — which is why the completeness guard does not
  /// mention this column.
  settledById      String?
  settledBy        User?     @relation("InvoiceSettler", fields: [settledById], references: [id], onDelete: SetNull)

  /// Cancelled before it was ever paid: the subscription was cancelled, the
  /// customer was comped, it was raised in error.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Never bill the same period twice. This is the constraint that makes the
  /// issuing sweep safe to run every minute: a second pass finds the row
  /// already there rather than raising a duplicate bill.
  @@unique([subscriptionId, periodStart])
  @@index([dueAt, settledAt])
  @@index([submittedAt])
}

model SubscriptionBenefit {
  id     String           @id @default(cuid())
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type BenefitType

  /// Empty means "every active service". Otherwise the benefit applies only to
  /// these service keys — this is how a discount gets scoped without a branch.
  serviceKeys ServiceKey[] @default([])

  /// Basis points, so 1250 == 12.5%. Whole-percent columns force us to
  /// re-migrate the first time marketing wants 7.5%.
  percentBasisPoints Int?

  /// FREE_DELIVERY: the order subtotal the benefit needs to trigger.
  minimumOrderCentavos   Int?
  /// FREE_DELIVERY: how many times per calendar month it may be used.
  monthlyUsageCap        Int?
  /// DISCOUNT_PERCENT: per-order ceiling on the discount.
  maxDiscountCentavos    Int?
  /// CREDIT_BACK_PERCENT: how much credit-back this benefit may accrue per
  /// calendar month.
  monthlyCeilingCentavos Int?

  /// Shown on the plan card. Never read by the pricing engine.
  displayLabel String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages          SubscriptionBenefitUsage[]
  appliedToOrders OrderAppliedBenefit[]

  @@index([planId, type])
}

model UserSubscription {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  /// No default: how a subscription was obtained is never a guess.
  origin SubscriptionOrigin

  /// Who granted a COMPED or PROMOTIONAL subscription, and why. A grant with no
  /// grantor is how comps quietly become policy.
  grantedByUserId String?
  grantedBy       User?   @relation("SubscriptionGrants", fields: [grantedByUserId], references: [id])
  grantNote       String?

  startedAt   DateTime  @default(now())
  renewsAt    DateTime
  cancelledAt DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  benefitUsages SubscriptionBenefitUsage[]
  invoices      SubscriptionInvoice[]

  /// One live subscription per person, enforced by a partial unique index in
  /// `prisma/sql/subscriptions.sql` — Prisma cannot express one, and an index
  /// alone would not stop a double enrollment from a double-clicked button.
  /// History is preserved by `endedAt`.
  @@index([userId, status])
  @@index([status, renewsAt])
  @@index([grantedByUserId])
}

/// Tracks consumption of capped benefits within a calendar month, so
/// `monthlyUsageCap` and `monthlyCeilingCentavos` are enforceable rather than
/// aspirational.
model SubscriptionBenefitUsage {
  id                 String              @id @default(cuid())
  userSubscriptionId String
  userSubscription   UserSubscription    @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  benefitId          String
  benefit            SubscriptionBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  /// First instant of the calendar month this row accounts for, in UTC.
  periodStart DateTime

  usageCount         Int @default(0)
  creditedCentavos   Int @default(0)
  discountedCentavos Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userSubscriptionId, benefitId, periodStart])
  @@index([periodStart])
}

/// What a specific order actually received, so we can answer "why was this
/// cheaper?" without re-running the pricing engine against changed config.
model OrderAppliedBenefit {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Exactly one of these two is set, enforced by
  /// `order_applied_benefit_names_one_source` in prisma/sql/loyalty_tiers.sql.
  /// Both nullable because either kind of benefit row may be deleted after an
  /// order has already been priced by it, and a receipt must survive that.
  benefitId String?
  benefit   SubscriptionBenefit? @relation(fields: [benefitId], references: [id])

  tierBenefitId String?
  tierBenefit   LoyaltyTierBenefit? @relation(fields: [tierBenefitId], references: [id])

  /// Which family this line came from, so a receipt can name it without
  /// inferring from which id happens to be null — and so a line whose benefit
  /// row was later deleted still knows what it was.
  source BenefitSource @default(SUBSCRIPTION)

  type               BenefitType
  displayLabel       String
  /// Positive centavos taken off the total by this benefit.
  amountCentavos     Int
  /// For CREDIT_BACK_PERCENT: credits to grant on completion, not a discount.
  creditBackCentavos Int         @default(0)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([benefitId, createdAt])
  @@index([tierBenefitId, createdAt])
}

/// Which of the two things that confer benefits conferred this one.
enum BenefitSource {
  SUBSCRIPTION
  LOYALTY_TIER
}

// -----------------------------------------------------------------------------
// 8. Unified support
// -----------------------------------------------------------------------------

/// One ticket model covering all services.
model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The vertical the ticket is about. NULL means an account-level or general
  /// issue that belongs to no single service.
  serviceType ServiceKey?
  service     Service?    @relation(fields: [serviceType], references: [key])

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id])

  /// Slug of the `FaqCategory` the customer entered through, so we can see
  /// which help topics generate tickets.
  categorySlug String?

  subject String
  body    String

  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(NORMAL)

  assignedAgentId String?
  assignedAgent   User?   @relation("SupportAgentTickets", fields: [assignedAgentId], references: [id])

  /// When support first said something back. NULL means nobody has answered
  /// yet, which is the only support number that matters — `updatedAt` moves
  /// when anything at all changes, so it cannot answer "is somebody waiting".
  /// Set once and never cleared: reopening a ticket does not un-answer it.
  firstRespondedAt DateTime?

  /// The last message on the thread, either direction. Orders the queue by
  /// "who has been ignored longest" rather than by when a thread began.
  lastMessageAt DateTime @default(now())

  /// When an administrator was told this was waiting. Once, like an error
  /// report — a ticket nobody has answered should nag on a schedule, not on
  /// every cron tick.
  alertedAt DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, priority, createdAt])
  @@index([serviceType, status])
  @@index([relatedOrderId])
  /// The waiting sweep: unanswered tickets, oldest first.
  @@index([status, firstRespondedAt])
}

model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorUserId  String?
  author        User?   @relation(fields: [authorUserId], references: [id])
  isFromSupport Boolean @default(false)

  body        String
  attachments String[] @default([])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Help-section categories. Driven by the Service registry: a category with a
/// `serviceType` only appears once that service exists, and a NULL
/// `serviceType` is the general/account section.
model FaqCategory {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  serviceType ServiceKey?
  service     Service?    @relation(fields: [serviceType], references: [key])

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles FaqArticle[]

  @@index([serviceType, sortOrder])
  @@index([isActive, sortOrder])
}

model FaqArticle {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  question  String
  answer    String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

// -----------------------------------------------------------------------------
// 7. Home screen supporting data
// -----------------------------------------------------------------------------

/// Promotions rail on the home screen. Scoped to service keys so a food-only
/// promo does not advertise itself once MART launches.
model Promotion {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String?
  ctaHref  String?

  serviceKeys ServiceKey[] @default([])
  cityIds     String[]     @default([])

  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([serviceKeys], type: Gin)
}

// -----------------------------------------------------------------------------
// 9. Notifications — an outbox, not a fire-and-forget
// -----------------------------------------------------------------------------

/// What happened. One value per moment worth telling somebody about, NOT one
/// per order status: most statuses are internal, and the map in
/// `src/lib/notifications/order-events.ts` decides which of them earn a message.
enum NotificationKind {
  /// To the store: an order is waiting for a decision.
  ORDER_SUBMITTED
  /// To the customer: the store took it.
  ORDER_ACCEPTED
  /// To the customer: it is ready and looking for a rider.
  ORDER_READY
  /// To the customer: a partner is on it.
  ORDER_RIDER_ASSIGNED
  /// To the customer: collected from the store.
  ORDER_PICKED_UP
  /// To the customer: the rider is outside.
  ORDER_ARRIVED
  /// To the customer: delivered.
  ORDER_DELIVERED
  /// To the customer, and to the store when the store was not the one who did it.
  ORDER_CANCELLED
  /// To the store: nobody answered in time and the order was lost.
  ORDER_LOST_TO_TIMEOUT
  /// To a fleet partner: a job is on offer, and the clock is running.
  DISPATCH_OFFER
  /// To the customer: credits arrived — credit-back, a refund, a promo.
  CREDITS_GRANTED
  /// To the subscriber: the term ended.
  SUBSCRIPTION_ENDED
  /// A subscription bill has been raised. Carries the amount, the reference to
  /// put in the transfer note, and the deadline — everything the customer
  /// needs without opening the app, because the whole point of billing ahead
  /// of the boundary is that they can act on it in time.
  SUBSCRIPTION_INVOICE_DUE
  /// The term ran out with the bill unpaid. Benefits have already stopped;
  /// this says so, and says paying still restores the plan.
  SUBSCRIPTION_PAST_DUE
  /// To the subscriber: somebody checked the transfer and the plan is on. The
  /// one subscription message a customer is actively waiting for — on a rail
  /// where a person confirms by hand there is real time between "I have sent
  /// it" and "we have it", and silence in that gap reads as a lost payment.
  SUBSCRIPTION_PAYMENT_CONFIRMED
  /// To the subscriber: the reference they gave did not check out. Carries the
  /// reason verbatim, because it is the only thing that says what to do next,
  /// and the bill is still owed — a mistyped digit is not a cancellation.
  SUBSCRIPTION_PAYMENT_REFUSED
  /// To somebody who tapped a coming-soon tile: that vertical is now live
  /// where they are. The only message in the system that somebody asked for
  /// in advance.
  SERVICE_NOW_AVAILABLE
  /// To an administrator: something is failing that was not failing before.
  /// The only kind addressed to the people running the business rather than
  /// to somebody using it.
  ERROR_DETECTED
  /// To the account: something changed about who can get into it. The one kind
  /// that exists to be unwelcome — if the person did not do this, they need to
  /// know within seconds, not at their convenience.
  SECURITY_ALERT
  /// To an administrator: somebody raised a ticket and nobody has answered it.
  /// The second kind addressed to the people running the business.
  SUPPORT_TICKET_WAITING
  /// To the customer: a person — not the system — replied to their ticket.
  SUPPORT_REPLY
  /// To somebody whose access to a store was granted, changed or taken away.
  /// Addressed to a person about a privilege they hold, so it goes out even
  /// though nothing is waiting on them.
  STORE_ACCESS_CHANGED
  /// To a shop or a fleet partner: customers have rated you since we last
  /// said so. A DIGEST, deliberately — one message covering several ratings
  /// rather than a buzz per star. Carries the scores and never the words.
  RATINGS_RECEIVED
  /// To the customer: their payment was matched and the order is moving. The
  /// one message somebody is actively waiting for while staring at the screen,
  /// which is why it is worth a push even though the order status message that
  /// follows says something similar.
  PAYMENT_CONFIRMED
  /// To the customer: something about their payment needs them. A reference we
  /// could not match, or an amount short of the total. Carries the reason
  /// verbatim, because it is the only thing that tells them what to do next.
  PAYMENT_NEEDS_ATTENTION
  /// To the customer: we are holding money for an order that is not going to
  /// happen, and it is coming back. Separate from PAYMENT_REFUNDED because
  /// "we owe you" and "it has been sent" are different promises, and on a rail
  /// where a person makes the transfer by hand there is real time between
  /// them. Saying "refunded" at cancellation would be a lie with a number on
  /// it.
  PAYMENT_REFUND_DUE
  /// To the customer: money went back. Separate from a cancellation, because
  /// "your order is off" and "the ₱324 is on its way back to your GCash" are
  /// two different facts and the second one is the one people chase.
  PAYMENT_REFUNDED
  /// To an administrator: a customer says they have paid and nobody has
  /// checked it yet. The third kind addressed to the people running the
  /// business, and the one with a customer waiting behind it.
  PAYMENT_AWAITING_REVIEW
  /// To a fleet partner: a decision was made about one of their applications.
  /// Named per service, because that is the only useful version of the news —
  /// "you are approved" without saying for what is not actionable. A refusal
  /// carries the reason verbatim, since the point is that they can fix it.
  FLEET_VERIFICATION_DECIDED
  /// To a fleet partner who is OFFLINE: their city has more orders than riders
  /// and there is extra money on every job right now.
  ///
  /// The only kind in the system that is an INVITATION rather than news about
  /// something that already happened — which is why it is the only `perishable`
  /// one, and the only one a recipient can decline without muting a channel.
  /// Surge that nobody is told about is a price rise with no incentive
  /// attached: the customer pays more and no more riders come out.
  SURGE_ACTIVE
  /// To whoever did the inviting: their referral has been settled, either paid
  /// or refused with a reason. Both cases are sent, because somebody who shared
  /// a code and watched a friend order deserves to know why nothing arrived —
  /// an unexplained absence is how a referral programme becomes a support
  /// queue.
  REFERRAL_SETTLED
  /// To a rider whose invite has been settled: theirs, or the one they were
  /// invited by. Separate from REFERRAL_SETTLED because the money is
  /// different — a partner bonus is MONEY added to what TARA owes them and
  /// paid in their next payout, not credits to spend on food — and a message
  /// that said "credits" to somebody who never orders would be worse than no
  /// message.
  PARTNER_REFERRAL_SETTLED
  /// To a shop whose introduction has been settled: the one it made, or the
  /// one it arrived through. Third of the three referral messages, and its own
  /// kind rather than a shared one because the sentence is different again:
  /// what qualified it is the OTHER shop's sales, and a shop reading "twenty
  /// deliveries" would be reading a rider's message.
  STORE_REFERRAL_SETTLED
  /// To an administrator: a market has sat at its top surge step long enough
  /// that it is not a spike. The fourth kind addressed to the people running
  /// the business, and the one that is not asking them to fix an incident —
  /// sustained surge is understaffing, and no price fixes understaffing.
  SURGE_SUSTAINED
}

/// How a message reaches someone.
///
/// IN_APP is the inbox and is always written — it is the record, and the only
/// channel that cannot fail for a reason outside our control.
///
/// PUSH reaches a closed tab and costs nothing per message, which is why it
/// carries every kind while SMS carries only the ones worth a peso. It needs a
/// browser that has granted permission and a live `WebPushSubscription`.
///
/// SMS reaches a phone with no app installed and no permission granted, which
/// is the one thing push cannot do. It is the expensive fallback, not the
/// default.
enum NotificationChannel {
  IN_APP
  PUSH
  SMS
}

/// Whether a message is worth interrupting someone for.
///
/// OPERATIONAL means somebody is waiting on an action: a store has an order to
/// accept, a partner has 60 seconds to answer. These ignore quiet hours.
/// INFORMATIONAL is news about something already in motion.
enum NotificationUrgency {
  OPERATIONAL
  INFORMATIONAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  /// Attempted and given up on, with the reason kept.
  FAILED
  /// Not attempted, on purpose: the recipient turned this channel off.
  SKIPPED
  /// Not attempted because it stopped being true before it could be sent.
  ///
  /// Only reachable for a `perishable` kind — a message whose whole content is
  /// "right now". "It is busy, come out" held overnight and delivered at 6am
  /// is not a late message, it is a false one, so it is dropped rather than
  /// deferred. Kept distinct from SKIPPED because "they muted this" and "we
  /// decided this had gone stale" are different facts, and only one of them
  /// means somebody chose not to hear it.
  EXPIRED
}

/// One thing that happened, addressed to one person.
///
/// A row per recipient rather than per event: "who has read this" is a property
/// of a person, and a shared row would need a join table to answer it.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    NotificationKind
  urgency NotificationUrgency

  /// Rendered at enqueue time, from the template map. Stored rather than
  /// re-rendered on read: what someone was told should not change because the
  /// copy was later edited, and the SMS body is already gone by then anyway.
  title String
  body  String

  /// The short form, for channels with no screen around them. Stored beside the
  /// long form because a text has to carry its own context — which order, which
  /// deadline — and because re-rendering at send time would let an edited
  /// template rewrite a message already queued.
  smsBody String

  /// Where tapping it goes — an in-app path, never an absolute URL.
  href String?

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  /// Makes enqueueing idempotent. A retried transition, a cron that runs twice,
  /// two tabs both advancing the same order — all collapse onto one row.
  dedupeKey String @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([relatedOrderId])
}

/// One attempt to put a notification through one channel.
///
/// Separate from `Notification` because delivery is per-channel and fails
/// per-channel: an SMS gateway timing out must not lose the inbox copy, and a
/// retry needs somewhere to count attempts.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  attempts          Int       @default(0)
  /// When the next attempt becomes due. Backoff writes this forward.
  nextAttemptAt     DateTime  @default(now())
  sentAt            DateTime?
  /// Kept on failure. A gateway's own words are usually the fastest diagnosis.
  lastError         String?
  /// Which sender handled it, and its reference, for support.
  provider          String?
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One delivery per channel per notification.
  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

/// A person's channel switches.
///
/// Absent means "the default for that channel", which lives in code — so a new
/// channel does not need a backfill to start behaving sensibly. IN_APP is not
/// representable here on purpose: the inbox is the record, and turning it off
/// would mean losing history rather than being left alone.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  enabled Boolean

  updatedAt DateTime @updatedAt

  @@unique([userId, channel])
}

/// A browser that has agreed to receive push, and the keys to encrypt for it.
///
/// One row per browser profile, not per person: somebody with a phone and a
/// laptop has two, and each has its own keys. The push service hands out the
/// endpoint; re-subscribing the same profile returns the same one, which is why
/// it is the natural unique key rather than a (user, device) pair we would have
/// to invent.
///
/// The two keys are the client's half of RFC 8291. They are not secrets we
/// chose and cannot be regenerated on our side — losing them means the
/// subscription is unusable and the browser has to subscribe again.
model WebPushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service's URL for this browser. Distinct per browser vendor:
  /// fcm.googleapis.com for Chrome, updates.push.services.mozilla.com for
  /// Firefox, web.push.apple.com for Safari.
  endpoint String @unique
  /// The browser's P-256 public key: 65 bytes uncompressed, base64url.
  p256dh   String
  /// The browser's 16-byte auth secret, base64url. Mixed into the key
  /// derivation so a push service that sees the ciphertext cannot read it.
  auth     String

  /// What the browser called itself when it subscribed, so somebody can
  /// recognise which device to remove from a list.
  userAgent String?

  createdAt  DateTime @default(now())
  /// Touched on every successful send. A stale value is how a dead device is
  /// spotted before the push service admits it.
  lastSeenAt DateTime @default(now())

  /// Set when the push service answers 404 or 410: the browser is gone for
  /// good. Kept rather than deleted, because "this person had push and lost
  /// it" is the answer to a support question that a missing row cannot give.
  expiredAt    DateTime?
  /// Consecutive soft failures — a 500 from the push service, a timeout.
  /// Reset on success. Not a reason to give up on its own.
  failureCount Int       @default(0)

  /// The delivery pass reads live subscriptions for one user, in this order.
  @@index([userId, expiredAt])
}

// -----------------------------------------------------------------------------
// 12. The admin console, and what it did
// -----------------------------------------------------------------------------

/// What an admin did. Named after the effect, not the screen it happened on.
///
/// Deliberately a closed set rather than a free-text action: a log you can
/// filter is a log somebody reads, and a new kind of privileged action should
/// be a decision, not a string somebody typed.
enum AdminAction {
  /// A vertical was switched on or off for everyone.
  SERVICE_AVAILABILITY_CHANGED
  /// A vertical was launched in, or withdrawn from, a city.
  SERVICE_CITY_CHANGED
  /// Somebody was blocked or unblocked.
  USER_BLOCK_CHANGED
  /// A signed correction to a credits balance, through the ledger.
  CREDITS_ADJUSTED
  /// A failed notification delivery was put back in the queue.
  DELIVERY_REQUEUED
  /// A complimentary subscription was granted or ended.
  SUBSCRIPTION_CHANGED
  /// An account's phone number was moved by support.
  ACCOUNT_RECOVERED
  /// Console access was granted to, or taken from, an account. Recorded even
  /// when it happened from a shell — see `scripts/grant-admin.ts`.
  ADMIN_ROLE_CHANGED
  /// An error report was marked fixed, or reopened.
  ERROR_REPORT_RESOLVED
  /// Somebody was given, moved between, or removed from a store's staff by an
  /// administrator. The console does this to bootstrap a NEW partner store,
  /// which has nobody at it who could invite the first owner.
  STORE_MEMBERSHIP_CHANGED
  /// A fleet partner was approved for, or refused, ONE service. Per service on
  /// purpose: approval to carry food is not approval to carry a passenger, and
  /// the audit trail has to be able to say which decision was made.
  FLEET_VERIFICATION_CHANGED
  /// A payout to a store or a rider was recorded as sent. Records a claim
  /// about the world: nothing in this system can move money, so the audit row
  /// and its reference are what make the claim checkable against a statement.
  SETTLEMENT_PAYOUT_RECORDED
  /// A rider handed in cash they had collected, and somebody recorded it.
  SETTLEMENT_REMITTANCE_RECORDED
  /// A signed correction to what a partner is owed. The settlement ledger's
  /// equivalent of a credits ADJUSTMENT, and audited for the same reason.
  SETTLEMENT_ADJUSTED
  /// A store's commission rate was changed. Audited because it changes what
  /// every future order pays that shop.
  /// A shop's logo or banner was replaced from the console.
  STORE_BRANDING_CHANGED

  STORE_COMMISSION_CHANGED
  /// A customer's payment was confirmed as received. Audited because it is the
  /// moment somebody decides money arrived, on the word of a person reading a
  /// statement — which is exactly the decision a dispute needs a record of.
  PAYMENT_CONFIRMED
  /// A claimed payment was refused. The reason goes to the customer as well as
  /// to the audit trail.
  PAYMENT_REFUSED
  /// Money was sent back to where it came from. Records that somebody said
  /// they made the transfer; the transfer itself happens outside this system,
  /// which is precisely why the claim needs a name against it.
  PAYMENT_REFUNDED
  /// A fleet partner was suspended from all work, or reinstated. Separate from
  /// the per-service decision because it is not a judgement about documents —
  /// it stops everything at once, and it is reversible.
  FLEET_SUSPENSION_CHANGED
  /// A surge step was created. Audited because from this moment customers in
  /// that city pay more when the market tightens, and the question a complaint
  /// raises is who decided that and when.
  SURGE_BAND_CREATED
  /// A surge step's threshold, amount or name was changed.
  SURGE_BAND_CHANGED
  /// The loyalty programme's rates, expiry or on/off state were changed.
  /// Audited for the same reason as the referral programme: it is a standing
  /// liability against every account at once, denominated in points that
  /// convert to money.
  LOYALTY_PROGRAMME_CHANGED
  /// A loyalty tier was added, changed or removed. Separate from the rates
  /// because a tier changes how fast points are earned, which is a different
  /// decision from what a point is worth.
  LOYALTY_TIER_CHANGED
  LOYALTY_TIER_BENEFIT_CHANGED
  LOYALTY_TIER_BENEFIT_REMOVED
  /// A signed correction to somebody's points, with a reason. The loyalty
  /// ledger's equivalent of a credits ADJUSTMENT.
  LOYALTY_POINTS_ADJUSTED
  /// The referral programme's amounts, caps or on/off state were changed.
  /// Audited because it is the only control in the console that creates a
  /// standing liability against every account at once — and because the
  /// amounts decide whether the feature can be farmed.
  REFERRAL_PROGRAMME_CHANGED
  /// The RIDER-invite programme's amounts, caps, delivery threshold or on/off
  /// state were changed. Kept separate from the customer one because it
  /// commits REAL MONEY rather than credits: every rider acquired through it
  /// adds to what TARA owes somebody, and the amounts decide what a rider
  /// costs to hire.
  PARTNER_REFERRAL_PROGRAMME_CHANGED
  /// The SHOP-referral programme's amounts, caps, earnings threshold or on/off
  /// state were changed. Third of three, and audited for the same reason as
  /// the second: it commits real money against every shop acquired through it.
  STORE_REFERRAL_PROGRAMME_CHANGED
  /// Somebody recorded which shop introduced another shop. The only referral
  /// attribution in the app that a PERSON makes rather than a code — a store
  /// does not sign itself up, so nothing in the system can know this fact.
  /// The audit row is what makes the claim checkable: who said it, and why.
  STORE_REFERRAL_ATTRIBUTED
  /// A surge step was switched off or back on. Kept distinct from a change
  /// because "surge was on at 6pm" is the fact a dispute turns on, and it
  /// should be answerable without reading a diff of amounts.
  SURGE_BAND_ACTIVATION_CHANGED
  /// A promo campaign was created. Audited because a public code is a spending
  /// decision whose size is decided by whoever screenshots it, and the row
  /// carries the caps that were set alongside the reason for setting them.
  PROMO_CODE_CREATED
  /// A promo code was switched off or back on. Distinct from creation because
  /// "was TARA50 live on Friday" is the question a complaint turns on, and it
  /// should be answerable without reading a diff.
  PROMO_CODE_ACTIVATION_CHANGED
  /// A gift card was issued. Audited because it is the only instrument here
  /// that puts spendable money into the hands of whoever holds a piece of
  /// paper — the row records the amount and the reason, and it is the only
  /// place the decision survives, since the card itself keeps no plaintext.
  GIFT_CARD_ISSUED
  /// A gift card was cancelled before anybody redeemed it. Separate from
  /// issuing because "was that card still good on Tuesday" is the question a
  /// customer standing at a counter is asking.
  GIFT_CARD_VOIDED
  /// A subscription transfer was confirmed as received. The same decision as
  /// PAYMENT_CONFIRMED and audited for the same reason, but kept distinct
  /// because this one also moves a term: it is the moment a month of benefits
  /// is granted on the word of a person reading a statement.
  SUBSCRIPTION_INVOICE_CONFIRMED
  /// A claimed subscription transfer was refused. The reason goes to the
  /// subscriber verbatim as well as to the audit trail, and the bill stays
  /// owed.
  SUBSCRIPTION_INVOICE_REFUSED
  /// A subscription bill nobody had paid was cancelled. Distinct from a
  /// refusal because this one says the money is no longer owed, which is a
  /// decision to forgo revenue rather than a judgement about a reference.
  SUBSCRIPTION_INVOICE_VOIDED
  /// A city was added to the serving area. Audited because it decides where
  /// this deployment claims to operate, and because a city with no delivery
  /// fee rule is a city where checkout fails rather than one that is simply
  /// closed.
  SERVICE_AREA_CREATED
  /// A city's name, province, region, map centre or on/off state changed.
  /// Switching one off is the closest thing here to withdrawing from a
  /// market, so it is not a quiet edit.
  SERVICE_AREA_CHANGED
  /// A delivery fee rule was created or changed for a service, either for one
  /// city or as the fallback for all of them. Audited because it sets what
  /// every future order in that city pays to be delivered — the same class of
  /// decision as a store's commission.
  DELIVERY_FEE_RULE_CHANGED
}

/// One privileged action, and why.
///
/// APPEND-ONLY, enforced by a trigger, for the same reason the credits ledger
/// is: an audit trail that can be edited answers no question worth asking. A
/// mistaken entry is corrected by a later entry.
///
/// `reason` is NOT NULL and non-trivial by CHECK constraint. An audit row
/// saying only that somebody's balance changed is a row nobody can act on —
/// support needs to know it was ticket #482, and the person deciding whether
/// this was legitimate needs it more.
model AdminAuditEvent {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id])

  action AdminAction

  /// The model that was touched, e.g. "User", "Service". A plain string rather
  /// than a relation because the subject can be any table, and a nullable
  /// foreign key per table would be a column per table.
  subjectType  String
  subjectId    String
  /// Something a person recognises without a lookup — a phone, a service key,
  /// an order number. Denormalised on purpose: the subject may later be
  /// renamed or deleted, and the log should still read.
  subjectLabel String

  reason String

  /// What changed, as before/after. Read-only, and never used for logic.
  detail Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([action, createdAt])
}

// -----------------------------------------------------------------------------
// 13. Account recovery
// -----------------------------------------------------------------------------

/// How somebody proved they should get the account back.
enum RecoveryMethod {
  /// Two channels: a code to an address verified BEFORE the phone was lost,
  /// then a code to the new number. Self-service, no human involved.
  VERIFIED_EMAIL
  /// An administrator moved the number, with a reason, through the console.
  /// For the people who never added an email — which will be most of them.
  SUPPORT_ASSISTED
}

/// One change of the login identity, and everything about it.
///
/// APPEND-ONLY, enforced by trigger, like the credits ledger and the admin
/// audit trail. This is the record of the single most dangerous operation in
/// the system: whoever holds an account's phone number holds its credits
/// balance, its order history and its saved addresses. A recovery that could
/// be edited afterwards would make the whole feature untrustworthy.
///
/// `previousPhone` is kept on purpose, and it is the ONLY place the old number
/// survives after the change — `User.phone` has moved on. It is what the
/// security alert is sent to, and what answers "was this me" months later.
model AccountRecovery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method RecoveryMethod

  /// The number the account had before. E.164.
  previousPhone String
  /// The number it has now. E.164.
  newPhone      String

  /// The address the code went to, for VERIFIED_EMAIL. NULL for a support
  /// recovery, where no email was involved.
  viaEmail String?

  /// Who did it, for SUPPORT_ASSISTED. NULL for self-service — the person
  /// themselves is `user`, and naming them twice would suggest otherwise.
  assistedByUserId String?
  assistedBy       User?   @relation("RecoveryAssistedBy", fields: [assistedByUserId], references: [id])
  /// Required for SUPPORT_ASSISTED by CHECK constraint. An identity moved
  /// without a written reason is indistinguishable from a takeover.
  reason           String?

  /// When the cooling-off freeze on the credits balance lifts.
  creditsFrozenUntil DateTime

  /// When the alert to `previousPhone` went out. NULL means it is still
  /// queued: the maintenance sweep sends it, because the recipient is a number
  /// this account no longer has and the outbox resolves recipients from the
  /// user row.
  alertSentAt DateTime?
  /// Kept if the alert could not be sent, so a failure is visible rather than
  /// looking like it was never attempted.
  alertError  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([previousPhone])
  /// The sweep's queue: recoveries whose alert has not gone out.
  @@index([alertSentAt, createdAt])
}

// -----------------------------------------------------------------------------
// 14. Demand for the verticals that do not exist yet
// -----------------------------------------------------------------------------

/// Somebody asked for a vertical that is not live where they are.
///
/// Four of the five services are coming-soon tiles, and the decision about
/// which to build next is otherwise a guess. This table is the only evidence
/// the product has: a tap on a dimmed tile, attributed to a city, so the
/// question "is Mart worth building" becomes "how many people in Iloilo asked
/// for it".
///
/// Two shapes of row, deliberately:
///
///  - **With a `userId`** — one row per account per service per city, with
///    `askCount` for the repeats. This is the number worth trusting: getting
///    an account requires a code sent to a real phone. It is also the only
///    kind of row that can be told when the service launches.
///  - **With `userId` NULL** — one shared counter row per service and city for
///    everybody who has not signed in. They see the tiles too, and counting
///    only signed-in people would measure the wrong population. Nothing
///    identifies them, nothing can be sent to them, and the tally can be
///    inflated by anybody who can post a form, which is why the console shows
///    the two numbers apart rather than adding them up.
model ServiceInterest {
  id String @id @default(cuid())

  serviceKey ServiceKey
  service    Service    @relation(fields: [serviceKey], references: [key], onDelete: Cascade)

  /// Where the person was standing. The whole point: a vertical launches one
  /// city at a time, so demand without a city cannot be acted on.
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// How many times this account (or how many anonymous visitors) asked.
  askCount Int @default(1)

  /// When we told them it launched. Only ever set on a row with a `userId` —
  /// there is no way to reach an anonymous visitor, so those rows stay null
  /// forever and the sweep filters them out.
  notifiedAt DateTime?

  createdAt   DateTime @default(now())
  lastAskedAt DateTime @default(now())

  /// One row per account per service per city. NULL userIds are not equal to
  /// each other in Postgres, so this does NOT constrain the anonymous rows —
  /// those are kept to one per pair by the recording function instead.
  @@unique([serviceKey, cityId, userId])
  @@index([serviceKey, cityId])
  /// The launch sweep's query: rows still waiting to be told.
  @@index([notifiedAt, serviceKey])
}

// -----------------------------------------------------------------------------
// 15. Error monitoring
// -----------------------------------------------------------------------------

/// Where an error came from. Not a severity — a location, because the first
/// question about a 500 is which surface it broke.
enum ErrorSource {
  /// Rendering a page, or a route handler.
  SERVER_REQUEST
  /// A server action: a form post, a button.
  SERVER_ACTION
  /// The maintenance sweep. Nobody is watching a screen when these happen,
  /// which is exactly why they need recording.
  CRON
  /// A React error boundary in the browser.
  CLIENT
  /// A background job or script with no request around it.
  BACKGROUND
}

/// One DISTINCT error, however many times it happened.
///
/// Grouped by `fingerprint` rather than stored per occurrence, which is the
/// decision that makes this table useful instead of enormous. A page failing
/// four hundred times in an hour is one row saying "four hundred times, first
/// at 14:02, still happening" — the shape somebody can act on — and a loop
/// cannot fill the disk.
///
/// The alternative, a row per occurrence, buys a timeline nobody reads at the
/// cost of an unbounded table on the day something breaks. Occurrence counts
/// and first/last timestamps carry the part of that timeline that matters.
///
/// Messages and stacks are REDACTED before they arrive here: see
/// `src/lib/monitoring/redact.ts`. An error log that captures the login code
/// it failed to send would be worse than no error log.
model ErrorReport {
  id String @id @default(cuid())

  /// Stable hash of kind, redacted message shape and top stack frame.
  fingerprint String @unique

  /// The constructor name: Error, TypeError, PrismaClientKnownRequestError.
  kind    String
  message String
  stack   String?

  source ErrorSource
  /// Path or action name, when known. Never a query string — those carry
  /// tokens, and a `next=` parameter is not worth grouping on.
  route  String?

  /// Next.js's own error digest, which is the only thing linking the opaque
  /// message a customer saw to the stack we recorded.
  digest String?

  /// Whose request it was, when there was a session. Nullable and never
  /// required: most errors happen to somebody we cannot name.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  occurrences Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Marked fixed by a person, through the console, with an audit entry.
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("ErrorResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  /// When the admins were told. Set by the cron, once, on first sight — so an
  /// error storm is one notification per distinct fault, not per occurrence.
  alertedAt DateTime?

  @@index([resolvedAt, lastSeenAt])
  @@index([alertedAt])
}

// -----------------------------------------------------------------------------
// 16. Backups
// -----------------------------------------------------------------------------

/// One attempt at taking a backup, successful or not.
///
/// The row exists so that "are backups running" is a question the console can
/// answer instead of a belief somebody holds. A cron that stopped working six
/// weeks ago looks exactly like a cron that is working, right up until the
/// morning somebody needs the dump.
///
/// Note the ordering: this row is written AFTER the dump completes, so it is
/// not inside the dump it describes. That is correct — a backup history that
/// restores along with the data would tell you about backups taken before the
/// restore point and nothing since.
model BackupRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// False for an attempt that failed. Failures are kept: a table of only
  /// successes cannot answer "when did this start going wrong".
  ok Boolean @default(false)

  /// Name only, never a full path — a path is deployment-specific and often
  /// says more about the host than anybody needs in a database.
  fileName  String?
  sizeBytes Int?
  /// SHA-256 of the file as written, so a later restore can prove it is the
  /// same bytes rather than assuming.
  checksum  String?
  encrypted Boolean @default(false)

  /// Redacted, like every other error message in this database.
  error String?

  /// When somebody actually restored this dump and checked it. A backup that
  /// has never been restored is a hope, not a backup — `npm run
  /// db:restore-check` is what sets this.
  verifiedAt DateTime?
  /// What the check found: table and row counts, and whether the ledger still
  /// adds up in the restored copy.
  verifyNote String?

  @@index([ok, startedAt])
  @@index([startedAt])
}

// -----------------------------------------------------------------------------
// Referrals
// -----------------------------------------------------------------------------

/// What a referral is worth, and how much of it one person may earn.
///
/// The amounts are DATA and there are no rows by default, the same posture as
/// commission starting at 0% and surge shipping with no bands — and here the
/// reason is sharper than consistency. **These two numbers decide whether the
/// feature is farmable.** A person with a drawer of SIM cards refers themselves:
/// they pay for one real order and collect both sides. Whether that nets them
/// money or costs them money is arithmetic on the amounts an operator chooses,
/// so `/admin/referrals` computes it and shows them, and the code invents
/// nothing.
///
/// One row, ever. Enforced by `referral_programme_singleton` in
/// `prisma/sql/referrals.sql`: two competing programmes would make what a
/// referral is worth depend on which row a query happened to read.
model ReferralProgramme {
  /// Always "default". A one-row table with a fixed key rather than a settings
  /// blob, so the columns are typed and a missing amount is a missing column
  /// rather than a missing JSON path nobody notices.
  id String @id @default("default")

  /// Off unless somebody turned it on. With this false the invite screen says
  /// so plainly rather than showing a code that earns nothing.
  isActive Boolean @default(false)

  /// To the person who was invited, granted when their account is attributed —
  /// before their first order, so it can pay for part of it, which is the whole
  /// incentive. The acquisition cost, in other words.
  refereeCentavos Int @default(0)

  /// To the person who invited them, granted only when the referee's first
  /// order COMPLETES. Never on signup: a reward for creating an account is a
  /// reward for owning a SIM card, and this one has to be earned by an order
  /// somebody paid for and received.
  referrerCentavos Int @default(0)

  /// A referee's order must be worth at least this much before the referrer is
  /// paid, so a ₱60 order cannot unlock a ₱100 reward.
  minimumOrderCentavos Int @default(0)

  /// How many referrals one account may be paid for, per calendar month and
  /// ever. The caps are what turn an unbounded liability into a budget, and
  /// they do the work that fraud detection cannot: an honest enthusiast and a
  /// farmer look identical for the first three referrals.
  monthlyRewardCap  Int @default(0)
  lifetimeRewardCap Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// What a rider gets for bringing a rider.
///
/// A SECOND programme rather than more columns on the first one, because the
/// two differ in every axis that matters: what qualifies (a delivery, not an
/// order), who is paid (a partner, not a customer), and what they are paid in
/// (money through the settlement ledger, not credits). Sharing a row would mean
/// one screen's amount deciding the other's.
///
/// Off, with every amount at zero, until somebody sets it — the same posture as
/// commission, surge and the customer programme. The amounts decide whether the
/// thing is worth farming, and that is not a decision code should make.
model PartnerReferralProgramme {
  /// Always "default". See `ReferralProgramme.id`.
  id String @id @default("default")

  isActive Boolean @default(false)

  /// To the rider who did the inviting.
  referrerCentavos Int @default(0)

  /// To the rider who was invited, on the same event. Deliberately not paid at
  /// signup: a bonus for creating an account is a bonus for owning a SIM card,
  /// and this one has to be earned by deliveries somebody actually made.
  refereeCentavos Int @default(0)

  /// How many completed deliveries the invited rider must have before either
  /// side is paid. This is the whole defence: a fake rider earns nobody
  /// anything, and a real one has already done the work the bonus is for.
  qualifyingDeliveries Int @default(0)

  /// How many invites one rider may be paid for, per calendar month and ever.
  /// The caps are what turn an unbounded liability into a budget.
  monthlyRewardCap  Int @default(0)
  lifetimeRewardCap Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// One rider having invited another.
///
/// Separate from `Referral` rather than a flag on it, for a reason worth
/// stating: `Referral.refereeId` is unique per USER, so one table could not
/// hold both a person's customer referral and their rider referral — and a
/// rider who was first invited to order by a friend, then invited to ride by
/// another rider, is the ordinary case rather than an edge one.
///
/// The CODE is not separate: both programmes resolve `User.referralCode`, so a
/// person has one code and what it earns depends on what the invitee does.
model PartnerReferral {
  id String @id @default(cuid())

  /// The rider who shared their code. Must already be a fleet partner — a
  /// customer who brings a rider has no settlement account to be paid into,
  /// and inventing one would be paying supply referrals in credits.
  referrerId String
  referrer   FleetPartner @relation("PartnerReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  /// The invited rider. Unique, so nobody is attributed twice.
  refereeId String       @unique
  referee   FleetPartner @relation("PartnerReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  /// The code as typed, kept verbatim for support — the same reason
  /// `Referral.codeUsed` keeps it.
  codeUsed String

  status ReferralStatus @default(ATTRIBUTED)

  /// What each side was accrued, and when. Null until the invited rider
  /// reaches the qualifying delivery count, and null forever if they never do.
  referrerRewardCentavos Int       @default(0)
  refereeRewardCentavos  Int       @default(0)
  rewardedAt             DateTime?

  /// The delivery that tipped them over, and how many they had at the time.
  /// The order is NOT on the settlement entry — see `REFERRAL_BONUS` — so this
  /// is the only place the two can be tied together afterwards.
  qualifyingOrderId String?
  qualifyingOrder   Order?  @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  qualifyingDeliveryCount Int?

  /// Why nothing was paid, when nothing was paid. Shown to the referrer.
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, createdAt])
}

/// Who invited whom, and what came of it.
///
/// One row per REFEREE, ever — `@@unique([refereeId])` plus an append-only-ish
/// guard on the attribution columns. Attribution is a fact about how somebody
/// arrived, and a fact that can be rewritten is not one: allowing an update
/// would let a second referrer claim an account after its first order, which
/// is the whole game.
model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)

  /// The invited account. Unique, so nobody can be referred twice.
  refereeId String @unique
  referee   User   @relation("RefereeReferral", fields: [refereeId], references: [id], onDelete: Cascade)

  /// The code as typed or followed, kept verbatim for support: "I used Ana's
  /// code" is answerable from this column even after Ana's code is reissued.
  codeUsed String

  status ReferralStatus @default(ATTRIBUTED)

  /// What the referee was granted at attribution, and when.
  refereeGrantedCentavos Int       @default(0)
  refereeGrantedAt       DateTime?

  /// What the referrer was paid, when, and for which order. Null until the
  /// referee's first order completes — and stays null forever if it never
  /// does, which is the point.
  referrerRewardCentavos Int       @default(0)
  referrerRewardedAt     DateTime?
  qualifyingOrderId      String?
  qualifyingOrder        Order?    @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)

  /// Why nothing was paid, when nothing was paid. Written for the operator and
  /// for the referrer's own screen: "your friend's order was cancelled" is an
  /// answer, and silence is not.
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, createdAt])
}

/// What a shop gets for bringing a shop.
///
/// The third referral programme, and the one whose shape is least like the
/// other two — because a shop does not sign itself up. A rider fills in an
/// application and can type a code into it; a store is CREATED IN THE CONSOLE
/// by somebody who is already talking to both shops. So there is no code here
/// at all: the attribution is a person naming a shop from a list, with their
/// own name and a reason against it.
///
/// Off, with every amount at zero, until somebody sets it.
model StoreReferralProgramme {
  /// Always "default". See `ReferralProgramme.id`.
  id String @id @default("default")

  isActive Boolean @default(false)

  /// To the shop that did the introducing.
  referrerCentavos Int @default(0)

  /// To the new shop, on the same event.
  refereeCentavos Int @default(0)

  /// How much the new shop must have EARNED through TARA before either side is
  /// paid — its own share of the food it has sold, summed from the settlement
  /// ledger.
  ///
  /// Earnings rather than an order count, unlike the rider programme's
  /// deliveries. A rider's deliveries are interchangeable units of work; a
  /// shop's orders are not, and twenty ₱120 orders is not a trading shop. It
  /// is also the number the shop already reads on its own payouts screen, so
  /// the threshold is something they can check rather than take on trust.
  qualifyingEarningsCentavos Int @default(0)

  /// How many introductions one shop may be paid for, per calendar month and
  /// ever.
  monthlyRewardCap  Int @default(0)
  lifetimeRewardCap Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// One shop having introduced another.
///
/// The row records a DECISION rather than an event a customer caused: an
/// administrator, talking to both shops, says who brought whom. That is why
/// `attributedById` and `attributionNote` are both required and why the write
/// is audited — the same posture as a comped subscription or a recorded
/// payout, and for the same reason. Nothing in the app can know this fact; a
/// person asserts it, and the row keeps their name.
model StoreReferral {
  id String @id @default(cuid())

  /// The shop that introduced the other one.
  referrerStoreId String
  referrerStore   Store  @relation("StoreReferrer", fields: [referrerStoreId], references: [id], onDelete: Cascade)

  /// The new shop. Unique, so nobody is attributed twice.
  refereeStoreId String @unique
  refereeStore   Store  @relation("StoreReferee", fields: [refereeStoreId], references: [id], onDelete: Cascade)

  /// Who said so, and why. Required, both of them: an unattributable claim
  /// about money owed is how a referral list stops being checkable.
  attributedById  String
  attributedBy    User   @relation("StoreReferralAttributor", fields: [attributedById], references: [id])
  attributionNote String

  status ReferralStatus @default(ATTRIBUTED)

  referrerRewardCentavos Int       @default(0)
  refereeRewardCentavos  Int       @default(0)
  rewardedAt             DateTime?

  /// What the new shop had earned when it qualified. The settlement entries
  /// carry no order — a bonus arises from the OTHER shop's trading — so this
  /// is the only place a payment can be traced to what earned it.
  qualifyingEarningsCentavos Int?

  /// Why nothing was paid, when nothing was paid. Shown to the shop.
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerStoreId, status])
  @@index([status, createdAt])
}

/// Shared by all three referral programmes — the customer one, which pays
/// credits, and the rider and shop ones, which pay money through the
/// settlement ledger. The
/// three states mean the same thing in all of them; what differs is what qualifies and
/// what gets paid, and that lives in each programme's own policy module rather
/// than in a second copy of this enum.
enum ReferralStatus {
  /// Attributed, and waiting on the thing that qualifies it: a customer
  /// referee's first completed ORDER, or a partner referee's Nth completed
  /// DELIVERY.
  ATTRIBUTED
  /// Paid. On a customer referral that is credits to the referrer; on a
  /// partner referral it is money accrued to both sides.
  REWARDED
  /// Attributed, but nothing will be paid, and `blockedReason` says why: a cap
  /// was reached, the programme was off, the qualifying order was too small. A
  /// terminal state rather than a silent nothing, so the referrer can be told
  /// and an operator can count how often it happens.
  NOT_REWARDED
}

// -----------------------------------------------------------------------------
// Loyalty points
// -----------------------------------------------------------------------------

/// The fourth append-only ledger, and the only one denominated in something
/// other than money.
///
/// Points measure what somebody has ORDERED. Credits measure what they can
/// SPEND. Keeping them apart is the whole reason this table exists rather than
/// crediting a few centavos per order straight into the wallet: a peso balance
/// cannot express "you are close to Gold", and a tier cannot be paid out.
///
/// Same discipline as the other three ledgers — append-only trigger, sign
/// forced by type, one write function, balance derived from the sum and never
/// set — because the moment a points balance can be written directly, points
/// become a thing anybody with database access can mint.
model LoyaltyAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived: sum(entries.points). Never assigned; see `loyalty/ledger.ts`.
  pointsBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries LoyaltyEntry[]
}

model LoyaltyEntry {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type LoyaltyEntryType

  /// Signed, and the sign is forced by type in `prisma/sql/loyalty.sql`:
  /// EARNED is positive, REDEEMED and EXPIRED are negative, ADJUSTED is either
  /// and needs an administrator against it.
  points Int

  /// What the customer reads in their history. Written once, at the time, so
  /// an edited template cannot rewrite what somebody was told they earned.
  description String

  /// The order that earned them. Required for EARNED — points come from
  /// orders, and a row that cannot name one is points from nowhere.
  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  /// For REDEEMED: the credits ledger row this became. The join between the
  /// two ledgers, and the only place points turn into money.
  walletTransactionId String?            @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  /// Required for ADJUSTED: which administrator, and their reason lives in the
  /// audit log against the same subject.
  adminUserId String?
  adminUser   User?   @relation("LoyaltyAdjustmentActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  /// Makes earning idempotent: one key per order, so a retried completion
  /// cannot earn twice.
  idempotencyKey String? @unique

  /// When these points stop counting. Set on EARNED only, from the
  /// programme's expiry window. Null means they never expire, which is what an
  /// unconfigured expiry means.
  expiresAt DateTime?

  createdAt      DateTime      @default(now())


  @@index([accountId, createdAt])
  @@index([type, expiresAt])
}

enum LoyaltyEntryType {
  /// Earned by completing an order.
  EARNED
  /// Turned into credits, at the programme's rate.
  REDEEMED
  /// Timed out unredeemed. The one thing credits deliberately never do, and
  /// the only mechanism that bounds what this programme can come to owe.
  EXPIRED
  /// A signed correction by an administrator, with a reason in the audit log.
  ADJUSTED
}

/// What a point is worth, and how fast one is earned.
///
/// Data with no rows by default, the same posture as commission at zero, surge
/// with no bands and referrals off. Here the reason is that a points programme
/// is a liability denominated in somebody else's money: at 1 point per peso and
/// 100 points to the peso, a million pesos of orders creates ten thousand pesos
/// of obligation. That is a decision about a business, not a default.
///
/// One row, ever — `loyalty_programme_singleton`.
model LoyaltyProgramme {
  id String @id @default("default")

  isActive Boolean @default(false)

  /// Points earned per whole peso of an order's SUBTOTAL. Basis points rather
  /// than a float so the arithmetic is exact: 10000 is one point per peso.
  pointsPerPesoBasisPoints Int @default(0)

  /// How many points buy one peso of credits. Higher means points are worth
  /// less. Kept as points-per-peso rather than centavos-per-point because that
  /// is the direction a customer reads it: "100 points = ₱1".
  pointsPerPesoRedeemed Int @default(0)

  /// Redemption happens in whole blocks of this many points, so a balance is
  /// never stranded as dust nobody can spend and every redemption is a round
  /// number of pesos.
  redemptionBlockPoints Int @default(0)

  /// How long points last before expiring, in months. Zero means they never
  /// expire — which is a choice, and the one that makes the liability
  /// unbounded, so the console says so.
  expiryMonths Int @default(0)

  /// The window a tier is calculated over, in months. Rolling rather than
  /// lifetime: a tier nobody can lose is not a reason to order again.
  tierWindowMonths Int @default(12)

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

/// A status band, earned by ordering.
///
/// Tiers change ONE thing: how fast points are earned. Deliberately not a
/// fourth discount mechanism — this app already has three ways to reduce a bill
/// (the fee rule's own free-delivery threshold, Plus benefits, and promo
/// discounts), and a tier that waived delivery would be a fourth with its own
/// interaction with the other three. A tier that earns faster compounds the
/// thing the programme is actually for, and needs no arithmetic anywhere near
/// the checkout.
model LoyaltyTier {
  id String @id @default(cuid())

  /// What the customer is called. "Suki" — the Filipino word for a regular
  /// customer, which is the whole idea and better than a metal.
  name String @unique

  /// Points earned inside the rolling window at or above which this tier
  /// applies. The base tier is threshold zero and everybody has it.
  thresholdPoints Int @unique

  /// Multiplies the earn rate, in basis points. 10000 is no change; 15000
  /// earns half again as fast.
  earnMultiplierBasisPoints Int @default(10000)

  /// Shown beside the tier name, so "why am I Suki" has an answer on screen.
  blurb String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  benefits LoyaltyTierBenefit[]
}

/// One thing a tier confers.
///
/// ### Why this is a table rather than more columns on the tier
///
/// `LoyaltyTier.earnMultiplierBasisPoints` was the only benefit a tier had,
/// and it was a column because there was exactly one. A tier that confers
/// three things needs rows: adding a fourth benefit type must not be a
/// migration, and an operator turning off free delivery for Tapat must not
/// mean nulling a column whose meaning depends on another column.
///
/// The columns mirror `SubscriptionBenefit` for the three bill types, on
/// purpose and to the letter — `applyBenefits` reads a structural type, so a
/// row here passes into the same engine that prices a Plus plan. Two
/// implementations of "free delivery over ₱300, four times a month" is how the
/// two disagree by a peso in month three.
///
/// ### What it does NOT get
///
/// No `isActive`. A benefit a tier does not confer is a row that is not there;
/// a flag would give every read two things to check and one of them would be
/// forgotten. The tier ladder itself is what an operator switches off.
model LoyaltyTierBenefit {
  id     String      @id @default(cuid())
  tierId String
  tier   LoyaltyTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  type TierBenefitType

  /// Empty means every active service. Same column, same meaning, same
  /// absence of a branch as `SubscriptionBenefit.serviceKeys`.
  serviceKeys ServiceKey[] @default([])

  /// Basis points, so 1250 is 12.5%.
  percentBasisPoints Int?

  /// FREE_DELIVERY: the subtotal the benefit needs to trigger.
  minimumOrderCentavos Int?
  /// FREE_DELIVERY: how many times per calendar month it may be used.
  monthlyUsageCap Int?
  /// DISCOUNT_PERCENT: per-order ceiling on the discount.
  maxDiscountCentavos Int?
  /// CREDIT_BACK_PERCENT: how much credit-back it may accrue per month.
  monthlyCeilingCentavos Int?

  /// DISPATCH_PRIORITY and SUPPORT_PRIORITY: how far ahead this tier goes.
  ///
  /// Deliberately small and bounded by `loyalty_tier_benefit_sane`. Priority
  /// is a tie-break between orders of similar age, not a licence to serve a
  /// suki's lunch before a stranger's breakfast — see `dispatchPriorityFor`.
  priorityWeight Int?

  /// Shown to the customer. Never read by any arithmetic.
  displayLabel String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages          LoyaltyBenefitUsage[]
  appliedToOrders OrderAppliedBenefit[]

  @@index([tierId, type])
}

/// A customer's use of one tier benefit in one calendar month.
///
/// The parallel of `SubscriptionBenefitUsage`, and it has to be a separate
/// table for a structural reason rather than a stylistic one: that table is
/// keyed by `userSubscriptionId`, and a tier benefit has no subscription. A
/// customer is Tapat because of what they ordered, not because of a row they
/// pay for, so the cap is counted against the USER.
///
/// Which also means it survives them dropping a tier and coming back: the
/// month's allowance is the month's allowance.
model LoyaltyBenefitUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tierBenefitId String
  tierBenefit   LoyaltyTierBenefit @relation(fields: [tierBenefitId], references: [id], onDelete: Cascade)

  /// First instant of the calendar month, UTC. Same convention as
  /// `currentPeriodStart` in lib/pricing/checkout.ts, which both tables share.
  periodStart DateTime

  usageCount         Int @default(0)
  creditedCentavos   Int @default(0)
  discountedCentavos Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tierBenefitId, periodStart])
  @@index([tierBenefitId, periodStart])
}

// -----------------------------------------------------------------------------
// Promo codes
// -----------------------------------------------------------------------------

/// A campaign code, with the rules that bound it.
///
/// `Order.promoDiscountCentavos` has existed since the first schema, the
/// benefit arithmetic has always handled it, both receipts have always shown
/// it, and settlement has always absorbed it against the platform's share —
/// and nothing ever set it. This is what sets it.
///
/// ### The thing that makes promo codes different from the other two
///
/// A referral code belongs to one person and pays credits. A loyalty balance
/// belongs to one person and converts to credits. **A promo code is public.**
/// It is written on a tarpaulin, posted in a Facebook group, and screenshotted
/// into a group chat, and a code meant for a hundred people is used by ten
/// thousand within the hour. So almost every column here is a bound, and the
/// two that matter most are `totalRedemptionLimit` and `budgetCentavos`: one
/// caps how many orders it can touch, the other caps what it can cost however
/// many that turns out to be.
///
/// ### Who pays for it
///
/// The platform, always. `splitOrderValue` gives the store its subtotal less
/// commission and the rider their fee regardless of any discount, so a promo
/// comes entirely out of the platform's share — which is correct and already
/// the case. A store-funded promo, where a shop subsidises its own campaign
/// out of its settlement, would be a change to the split rather than a column
/// here, so there is deliberately no `fundedByStore` flag sitting unwired.
/// A gift card TARA issues, redeemable once by whoever holds the code.
///
/// ### What this is NOT
///
/// It is not a card a customer BUYS. That would be a top-up (their cash
/// becoming a balance) and a transfer (the balance ending up with somebody
/// else), and both are named in the "do not add these" block at the foot of
/// src/lib/wallet/ledger.ts — the whole reason this app has credits rather
/// than a wallet. Selling stored value is a different product with a
/// different licence.
///
/// What it IS: an instrument for US to give credits away without needing to
/// know whose account they are going to. Support goodwill for somebody who
/// has not signed in yet, a printed card for a launch event, a partner
/// giveaway. It resolves to a `GIFT_CARD` row in the credits ledger, which
/// already cannot be transferred or cashed out.
///
/// ### The one thing that makes it different from a promo code
///
/// A promo code is public by design and its defence is the caps. A gift card
/// is a BEARER INSTRUMENT: the string itself is worth money, so the defence
/// is that it cannot be guessed and cannot be read back out of the database.
model GiftCard {
  id String @id @default(cuid())

  /// The bearer code, HASHED — the plaintext is returned once, to the
  /// administrator who issued it, and never stored or shown again.
  ///
  /// Plain SHA-256 rather than the OTP's keyed HMAC, for two reasons. The code
  /// is ~78 bits of CSPRNG output, so there is no dictionary to attack and
  /// nothing for a key to protect against. And an HMAC would tie every
  /// outstanding card to `AUTH_SECRET`: rotating that secret is a routine
  /// security action, and it would silently void every gift card in
  /// circulation — destroying money owed to people holding paper. Same
  /// reasoning as `hashSessionToken`.
  codeHash String @unique

  /// A non-secret handle, so the console can list, discuss and void a card
  /// without holding anything worth stealing. Generated independently of the
  /// code rather than being a prefix of it, so it leaks no entropy at all.
  reference String @unique

  /// Face value. What redeeming it puts in somebody's credits.
  amountCentavos Int

  /// Who issued it. A gift card is us giving money away, so it is
  /// attributable — and the reason is on the row, not only in the audit log,
  /// because the console lists cards and not audit events.
  issuedById   String?
  issuedBy     User?   @relation("GiftCardIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedReason String

  /// Free text for whoever comes back to this later: which event, which
  /// ticket, which partner.
  note String?

  /// NULL means it never expires, and that is the default.
  ///
  /// Deliberate: RA 10962 (the Gift Check Act) says gift checks sold in the
  /// Philippines may not expire, and while a card we give away for nothing is
  /// arguably not a gift check that was sold, the safe direction is obvious.
  /// An expiry we should not have enforced is a consumer-protection problem;
  /// no expiry is a balance-sheet figure the console already shows.
  expiresAt DateTime?

  /// Set together, or not at all — see `gift_card_redemption_is_complete`.
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?     @relation("GiftCardRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  /// The credits row this became. A plain id and NOT a foreign key, on
  /// purpose: purging an account cascades its ledger away, and a FK would
  /// either block the purge or null this column out — which would make a
  /// redeemed card look unredeemed and hand somebody a second one. The fact
  /// that it was redeemed, and which row recorded it, is history rather than
  /// a live pointer.
  walletTransactionId String? @unique

  /// A card can be cancelled before it is redeemed — printed wrong, lost,
  /// issued by mistake. Never after: the credits are already spendable, and a
  /// correction to a balance is an ADJUSTMENT.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("GiftCardVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Status is DERIVED from the three timestamps and the clock, never stored.
  /// A `status` column beside them would be a second truth, and the first time
  /// it drifted a redeemed card would read as issued.
  @@index([redeemedAt])
  @@index([expiresAt])
  @@index([issuedById, createdAt])
}

model PromoCode {
  id String @id @default(cuid())

  /// Uppercase, trimmed. Marketing chooses these, so unlike a referral code
  /// it is a word somebody can remember and say out loud — which is also why
  /// it is guessable, and why the caps rather than secrecy are the defence.
  code String @unique

  /// What the customer reads on their bill next to the money. A code with no
  /// name reads as a mistake, the same reason a surge band carries a label.
  label String

  kind PromoKind

  /// For PERCENTAGE. Basis points: 1000 is 10%.
  percentBasisPoints  Int?
  /// For FIXED_AMOUNT.
  amountCentavos      Int?
  /// The ceiling on one order's discount. REQUIRED for PERCENTAGE — see
  /// `promo_percentage_needs_a_ceiling`. A percentage with no ceiling is
  /// unbounded on a large order, which is the classic way a campaign becomes
  /// a story.
  maxDiscountCentavos Int?

  /// Below this the code does not apply. The main lever for making a campaign
  /// pay for itself.
  minimumOrderCentavos Int @default(0)

  /// Empty means every service. Read from the registry, never a hardcoded
  /// list — the same rule as everything else keyed on a vertical.
  serviceTypes ServiceKey[] @default([])
  /// Empty means every city.
  cityIds      String[]     @default([])
  /// Set for a code that only works at one shop.
  storeId      String?
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  /// Only for somebody who has never had an order delivered. An acquisition
  /// code, in other words, and the test is a COMPLETED order rather than any
  /// order — somebody whose only order was cancelled has never been served.
  firstOrderOnly Boolean @default(false)

  startsAt DateTime
  endsAt   DateTime

  /// Null means no limit on how many orders may use it. Set it. A code with no
  /// total limit is a code whose cost is decided by whoever screenshots it.
  totalRedemptionLimit Int?
  /// How many times one account may use it. One, usually.
  perCustomerLimit     Int  @default(1)
  /// The most this code may give away in total, across every redemption. Null
  /// means unbounded, which the console warns about.
  budgetCentavos       Int?

  /// Whether this may be combined with a subscription's own benefits. When
  /// false the two are priced separately and the CHEAPER BILL WINS — see
  /// `bestOutcome` in src/lib/pricing/checkout.ts. Dropping the plan outright
  /// would make a subscriber pay more for typing a code than for typing
  /// nothing, and when the plan wins the code is left unspent.
  stacksWithSubscription Boolean @default(true)

  isActive Boolean @default(true)

  /// Who created it. A campaign is a spending decision and this is half of the
  /// record of it; the other half is the audit row with the reason.
  createdById String?
  createdBy   User?   @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@index([storeId])
}

enum PromoKind {
  /// A percentage off the subtotal, capped by `maxDiscountCentavos`.
  PERCENTAGE
  /// A flat amount off.
  FIXED_AMOUNT
  /// The delivery fee, whatever it happens to be for that order. Resolves to
  /// a centavos figure like the other two, so the checkout arithmetic needs no
  /// third case — and so a customer sees one discount line rather than a fee
  /// that mysteriously reads zero.
  FREE_DELIVERY
}

/// One use of one code, on one order.
///
/// There is no cached counter on `PromoCode`. Usage is COUNTED from these rows
/// every time it matters, which is a few more reads in exchange for there being
/// exactly one truth about whether a cap has been reached. A cached count is a
/// second truth, and the moment it drifts a code either stops working early or
/// keeps working past its budget — and nobody notices which.
model PromoRedemption {
  id String @id @default(cuid())

  /// RESTRICT, not Cascade. A code that has been used cannot be deleted —
  /// switch it off instead. Cascading would let deleting one row erase every
  /// record of what a campaign cost, while leaving `promoDiscountCentavos` on
  /// each order: a discount with no reason, and a marketing spend with no
  /// total. The same discipline as the ledgers, for the same reason.
  ///
  /// The other two relations stay Cascade: purging an ACCOUNT or an ORDER
  /// should take its redemption with it, which is what the append-only
  /// trigger's `tara.allow_purge` hatch exists to allow.
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One redemption per order, ever. The unique index is what makes consuming
  /// a code idempotent under a retried placement.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// What it actually took off, resolved at placement. Stored because the
  /// code's rules can change afterwards and a receipt must not restate itself
  /// — the same lesson `settlement/earnings.ts` learned about rider pay.
  discountCentavos Int

  createdAt DateTime @default(now())

  @@index([promoCodeId, createdAt])
  @@index([promoCodeId, userId])
}
